<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <attribute name="class" value="simple-structure"/>
        <referenceContainer name="columns">
            <container name="deals.container.wrapper" htmlTag="div" htmlClass="column-bottom" after="-">
                <block class="Magento\Cms\Block\Block" name="locator.deals.and.offers">
                    <arguments>
                        <argument name="block_id" xsi:type="string">deals-offers-main</argument>
                    </arguments>
                </block>
            </container>
        </referenceContainer>
        <referenceBlock name="page.main.title">
            <action method="setPageTitle">
                <argument name="label" translate="true" xsi:type="string">Find a Store</argument>
            </action>
        </referenceBlock>
    </body>
</page>
