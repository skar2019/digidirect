<style type="text/css">
    .sticky {
        position: fixed;
        top: 0;
        width: 100%;
        z-index: 99;
        border-bottom: 1px solid #e6e6e6;
        max-width: 1440px;
        margin-left: -9999px;
        margin-right: -9990px;
        padding-left: 9999px !important;
        padding-right: 9999px !important;
    }
    
    .sticky + .page-main {
        padding-top: 102px;
    }
    
    .navigation > .ninjamenus.ninjamenus-desktop {
        padding-left: 35px !important;
    }
    
    .ninjamenus-top-triggered-sticky {
        position: static !important;
        width: auto;
        padding-top: 15px;
        padding-right: 15px;
        box-sizing: content-box;
    }

    .ninjamenus-top-triggered-sticky:before{
        display: none !important;
    }

    .ninjamenus-top-triggered-sticky > .svg-icon {
        width: 20px;
        height: 20px;
    }
    
    .ninjamenus-scrolltofixed {
        top: 90px !important;
        z-index: 98 !important;
    }
    
</style>

<script>
    
    require(['jquery', 'owl_carousel'],
        function ($) {
            
            $(".top-red-banner-wrapper").slideDown("slow");
            
            $(window).scroll(function() {stickyHeader()}); // OR  $(window).scroll(function() {
            var header = document.getElementById("main-header-wrapper");
            var trigger = document.getElementById("header-toggle-nav");
            var sticky = header.offsetTop;

            function stickyHeader() {
                
                if (window.pageYOffset > sticky) {
                    header.classList.add("sticky");
                    trigger.classList.add("ninjamenus-top-triggered-sticky");
                } else {
                    header.classList.remove("sticky");
                    trigger.classList.remove("ninjamenus-top-triggered-sticky");
                }
            }
            $(".top-red-banner-block").click(function() {
                $(".top-red-banner-wrapper").slideUp("slow");
            });
            
            $(window).load(function() {
                //$(".top-red-banner-wrapper").slideDown("slow");
            });
           
            
        }
    );
    
</script>