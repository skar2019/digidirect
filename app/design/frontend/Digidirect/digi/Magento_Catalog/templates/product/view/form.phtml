<?php $_helper = $this->helper('Magento\Catalog\Helper\Output'); ?>
<?php $_product = $block->getProduct(); ?>
<?php
$_objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$currencysymbol = $_objectManager->get('Magento\Store\Model\StoreManagerInterface');
$currencyCode = $currencysymbol->getStore()->getCurrentCurrencyCode();
$points = $_product->getFinalPrice();
$finalQffPoints = $_product->getPoints();
$finalProductPrice = $_product->getFinalPrice();
$qff_bonus_points = 0;

$sourceDataBySku = \Magento\Framework\App\ObjectManager::getInstance()->get(\Magento\InventoryCatalogAdminUi\Model\GetSourceItemsDataBySku::class);


if ($_product->offsetExists("qff_bonus_points") && $_product->offsetExists("qff_base")) {
    $qff_bonus_points = $_product->getQffBonusPoints();
    $qff_base_points = $_product->getQffBase();
    $bonusPlusBase = $qff_bonus_points + $qff_base_points;

    $points = number_format($finalProductPrice * $bonusPlusBase);
}else {
    if($_product->offsetExists("qff_base")){
        $qff_base_points = $_product->getQffBase();
        $points = number_format($finalProductPrice * $qff_base_points);
    } else {
        $points = number_format($finalProductPrice * 2);
    }
} 
?>

<?php
    $productData = $sourceDataBySku->execute($_product->getSku());
    $productQuantity = 0;

    foreach($productData as $key => $value){
        if($value["source_status"] == true){
            $productQuantity += $value["quantity"];
        }
    }
?>

<?php if ($productQuantity > 0):?>
