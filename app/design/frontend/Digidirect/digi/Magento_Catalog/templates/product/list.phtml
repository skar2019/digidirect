<script>
    require([
        'jquery'
    ],
    function ($) {
        $(window).on('resize', function(){
            var currentPage = "<?= $currentPage ?>";
            var categoryName = "<?= $categoryName ?>";
            if (currentPage != "catalogsearch_result_index") {
                if (categoryName == "digiSeconds" ||
                    categoryName == "REFURB" ||
                    categoryName == "OPENBOX" ||
                    categoryName == "PRELOVED") {
                    var win = $(this);
                    if (win.width() >= 1440) {
                        $('.product-item-info>a').addClass('digiseconds-left-width');
                        $('.testfreaks-items').addClass('digiseconds-left-width');
                        $('.product-reviews-summary').addClass('digiseconds-left-width');
                        $('.product-item-name').addClass('digiseconds-left-width');
                        $('.product-item-details').addClass('digiseconds-left-width');
                        $('.digiseconds-product-details').attr("style", "display:block !important;");
                        $('.digiseconds-savings').attr("style", "display:block !important;");
                        $('.default-product-name').attr("style", "display:none !important;");
                    } else {
                        $('.product-item-info>a').removeClass('digiseconds-left-width');
                        $('.testfreaks-items').removeClass('digiseconds-left-width');
                        $('.product-reviews-summary').removeClass('digiseconds-left-width');
                        $('.product-item-name').removeClass('digiseconds-left-width');
                        $('.product-item-details').removeClass('digiseconds-left-width');
                        $('.digiseconds-product-details').attr("style", "display:none !important;");
                        $('.digiseconds-savings').attr("style", "display:none !important;");
                        $('.default-product-name').attr("style", "display:block !important;");
                    }
                }
            }
        }); 
        
        $(".product-category-listing .product-items").bind("DOMSubtreeModified", function() {
            var currentPage = "<?= $currentPage ?>";
            var categoryName = "<?= $categoryName ?>";
            if (currentPage != "catalogsearch_result_index") {
                if (categoryName == "digiSeconds" ||
                    categoryName == "REFURB" ||
                    categoryName == "OPENBOX" ||
                    categoryName == "PRELOVED") {
                    var win = $(window);
                    if (win.width() >= 1440) {
                        $('.product-item-info>a').addClass('digiseconds-left-width');
                        $('.testfreaks-items').addClass('digiseconds-left-width');
                        $('.product-reviews-summary').addClass('digiseconds-left-width');
                        $('.product-item-name').addClass('digiseconds-left-width');
                        $('.product-item-details').addClass('digiseconds-left-width');
                        $('.digiseconds-product-details').attr("style", "display:block !important;");
                        $('.digiseconds-savings').attr("style", "display:block !important;");
                        $('.default-product-name').attr("style", "display:none !important;");
                    } else {
                        $('.product-item-info>a').removeClass('digiseconds-left-width');
                        $('.testfreaks-items').removeClass('digiseconds-left-width');
                        $('.product-reviews-summary').removeClass('digiseconds-left-width');
                        $('.product-item-name').removeClass('digiseconds-left-width');
                        $('.product-item-details').removeClass('digiseconds-left-width');
                        $('.digiseconds-product-details').attr("style", "display:none !important;");
                        $('.digiseconds-savings').attr("style", "display:none !important;");
                        $('.default-product-name').attr("style", "display:block !important;");
                    }
                    
                    if (categoryName == "digiSeconds" ||
                        categoryName == "REFURB" ||
                        categoryName == "OPENBOX" ||
                        categoryName == "PRELOVED") {
                        //alert("This is digiSeconds category page!");
                        $('.product-item').addClass('digiseconds-li');
                    }
                }
            }
            
            setTimeout(function() {
                $('.block-content.filter-content').attr("style", "display: block !important;").fadeIn();
            }, 2000);
        });
        var categoryName = "<?= $categoryName ?>";
        if (categoryName == "digiSeconds" ||
            categoryName == "REFURB" ||
            categoryName == "OPENBOX" ||
            categoryName == "PRELOVED") {
            $('.product-category-listing>.product-items>.product-item>.product-item-info>a>span>.product-image-wrapper>.product-image-photo').attr("style", "margin-top: 70px !important;");
        }
        
        $('.product-category-listing li .product-item-info .product-item-photo').each(function(){
            if ($(this).find('.product-overlay').length) {
                $(this).find('.digiseconds-overlay').attr("style", "margin-top: -5px !important; margin-left: 40px !important;");
            }
        });
        
    });
</script>

