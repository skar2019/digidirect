<script>
    if (typeof window.fotoramaDefaults === 'undefined') {
        window.fotoramaDefaults = {};
        window.fotoramaDefaults.thumbmargin = 10;
        window.fotoramaDefaults.navwidth = "530px";
    } else {
        window.fotoramaDefaults.thumbmargin = 10;
        window.fotoramaDefaults.navwidth = "530px";
    }
    
    require(['jquery', 'jquery/ui'],function(){
        jQuery(window).load(function() {
            jQuery(".fotorama__thumb__arr.fotorama__thumb__arr--left").hide();
            jQuery(".fotorama__thumb__arr.fotorama__thumb__arr--right").hide();
            
            jQuery('<div class="fotorama__thumb__arr fotorama__thumb__arr--left" role="button" aria-label="Previous" data-gallery-role="arrow" tabindex="-1" style="height: 67px;"><div class="fotorama__thumb--icon"></div></div>').clone().prependTo('.fotorama__nav-wrap.fotorama__nav-wrap--horizontal');
            jQuery('<div class="fotorama__thumb__arr fotorama__thumb__arr--right" role="button" aria-label="Next" data-gallery-role="arrow" tabindex="-1" style="height: 75px;"><div class="fotorama__thumb--icon"></div></div>').clone().appendTo('.fotorama__nav-wrap.fotorama__nav-wrap--horizontal');
        });
    });
</script>