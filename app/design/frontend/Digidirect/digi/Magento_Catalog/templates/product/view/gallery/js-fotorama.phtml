<script>
    if (typeof window.fotoramaDefaults === 'undefined') {
        window.fotoramaDefaults = {};
        window.fotoramaDefaults.thumbmargin = 10;
        window.fotoramaDefaults.navwidth = "530px";
    } else {
        window.fotoramaDefaults.thumbmargin = 10;
        window.fotoramaDefaults.navwidth = "530px";
    }
    
    require(['jquery'],function(){
        jQuery(document).ready(function() {
            jQuery(".fotorama__thumb__arr.fotorama__thumb__arr--left").remove();
            jQuery(".fotorama__thumb__arr.fotorama__thumb__arr--right").remove();
            
            jQuery('<div class="fotorama__thumb__arr fotorama__thumb__arr--left" role="button" aria-label="Previous" data-gallery-role="arrow" tabindex="-1"><div class="fotorama__thumb--icon"></div></div>').appendTo('.fotorama__nav-wrap.fotorama__nav-wrap--horizontal');
            jQuery('<div class="fotorama__thumb__arr fotorama__thumb__arr--right" role="button" aria-label="Previous" data-gallery-role="arrow" tabindex="-1"><div class="fotorama__thumb--icon"></div></div>').appendTo('.fotorama__nav-wrap.fotorama__nav-wrap--horizontal');
        });
    });
</script>