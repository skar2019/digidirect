<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="2columns-left" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <head>  
            <script src="js/category-page.js"/>
        </head>
        <referenceBlock name="breadcrumbs" remove="false"/>
        <referenceBlock name="category.cms" remove="true"/>
        
        <move element="page.main.title" destination="category.view.container" before="-"/>
        
        <referenceContainer name="content">
            <block class="Magento\Cms\Block\Block" name="pdp.banner" before="category.products">
                <arguments>
                    <argument name="block_id" xsi:type="string">pdp-banner</argument>
                </arguments>
            </block>
        </referenceContainer>
        
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template" template="Magento_Catalog::category/banner-category.phtml" name="banner-category" before="category.products"/>
            <block class="Magento\Framework\View\Element\Template" template="Magento_Catalog::category/custom-featured-banner.phtml" name="custom-featured-banner" after="banner-category"/>  
        </referenceContainer>

        <referenceBlock name="category.products.list">
            <block class="Magento\Cms\Block\Block" name="product.tile.rent">
                <arguments>
                    <argument name="block_id" xsi:type="string">product-tile-rent</argument>
                </arguments>
            </block>
        </referenceBlock>

        <referenceContainer name="div.sidebar.additional" remove="true" />
   
<!--        <referenceContainer name="category.view.container" htmlClass="category-view full-width-background category-background">
            <block class="Magento\Framework\View\Element\Template" name="category.view.bg"
                   after="-"
                   template="Magento_Catalog::category/category-bg.phtml">
            </block>
        </referenceContainer>-->

        <move element="category.description" destination="main.content" after="-" />
        <move element="breadcrumbs" destination="columns.top" before="-"/>
    </body>
</page>
