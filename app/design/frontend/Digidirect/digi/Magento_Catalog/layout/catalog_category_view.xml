<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="2columns-left" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="breadcrumbs" remove="false"/>
        <referenceBlock name="category.cms" remove="true"/>
        
        <referenceContainer name="content" remove="true"/>

        <referenceBlock name="category.products.list">
            <block class="Magento\Cms\Block\Block" name="product.tile.rent">
                <arguments>
                    <argument name="block_id" xsi:type="string">product-tile-rent</argument>
                </arguments>
            </block>
        </referenceBlock>

        <referenceContainer name="div.sidebar.additional" remove="true" />
        
        <move element="side.banner.ads" destination="page.wrapper" before="page.messages" />
        <move element="category.description" destination="main.content" after="-" />
        <move element="breadcrumbs" destination="columns.top" before="-"/>
        
    </body>
</page>