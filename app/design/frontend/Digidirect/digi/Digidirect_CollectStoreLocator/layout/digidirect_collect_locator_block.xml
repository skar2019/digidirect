    <body>
        <referenceBlock name="storelocator.list" template="Digidirect_StoreLocator::list/items.phtml">
            <arguments>
                <argument name="jsLayout" xsi:type="array">
                    <item name="types" xsi:type="array"/>
                    <item name="components" xsi:type="array">
                        <item name="locator_list" xsi:type="array">
                            <item name="component" xsi:type="string">Digidirect_Locator/js/view/list</item>
                            <item name="config" xsi:type="array">
                                <item name="template" xsi:type="string">Digidirect_CollectStoreLocator/locator/result</item>
                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
