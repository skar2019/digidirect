<?php
/** @var $block \Magento\Checkout\Block\Cart\Sidebar */
/** @var \Magento\Framework\View\Helper\SecureHtmlRenderer $secureRenderer */
?>
<div data-block="minicart" class="minicart-wrapper">
    <!-- 🔹 Wishlist -->
    <a class="wishlist-container" href="<?= $block->getUrl('wishlist') ?>">
        <img src="<?= $block->getViewFileUrl('images/icons/iconsax-heart.svg') ?>" alt="Wishlist" />
        <span>Wishlist</span>
        <?php
        $objectManager = \Magento\Framework\App\ObjectManager::getInstance();
        $wishlist = $objectManager->create(\Magento\Wishlist\Model\Wishlist::class);
        $customerSession = $objectManager->get(\Magento\Customer\Model\Session::class);
        if ($customerSession->isLoggedIn()) {
            $wishlist = $wishlist->loadByCustomerId($customerSession->getCustomerId(), true);
            ?>
            <div class="wishlist-count"><?= $wishlist->getItemsCount() ?></div>
            <?php
        }
        ?>
    </a>

    <!-- 🔹 Cart Trigger -->
    <a class="action showcart" href="javascript:void(0);" data-bind="scope: 'minicart_content'">
        <img src="<?= $block->getViewFileUrl('images/icons/iconsax-shopping-cart.svg') ?>" alt="Cart" />
        <span>Cart</span>
        <span class="text"><?= $block->escapeHtml(__('My Cart')) ?></span>
        <span class="counter qty empty"
              data-bind="css: { empty: !getCartParam('summary_count') }, blockLoader: isLoading">
            <span class="counter-number" data-bind="text: getCartParam('summary_count')"></span>
        </span>
    </a>

    <!-- 🔹 Login -->
    <a href="<?= $block->getUrl('customer/account/login') ?>">
        <img src="<?= $block->getViewFileUrl('images/icons/iconsax-user.svg') ?>" alt="Login" />
        <span>Login</span>
    </a>

    <!-- 🔹 Default Dropdown Container -->
    <div class="block block-minicart"
         data-role="dropdownDialog"
         data-mage-init='{
            "dropdownDialog": {
                "appendTo": ".minicart-wrapper",
                "triggerTarget": ".showcart",
                "timeout": 0,
                "closeOnClickOutside": true,
                "closeOnEscape": true,
                "triggerClass": "active",
                "parentClass": "active",
                "buttons": []
            }
         }'
         aria-hidden="true"
         data-bind="scope: 'minicart_content'">

        <!-- ko template: getTemplate() --><!-- /ko -->
    </div>

    <!-- 🔹 Knockout / JS Init -->
    <?= $block->getChildHtml('minicart.addons') ?>
    <?= /* @noEscape */ $secureRenderer->renderTag(
        'script',
        [],
        'window.checkout = ' . /* @noEscape */ $block->getSerializedConfig(),
        false
    ); ?>

    <script type="text/x-magento-init">
    {
        "*": {
            "Magento_Ui/js/core/app": <?= /* @noEscape */ $block->getJsLayout() ?>
        },
        ".showcart": {
            "Magento_Checkout/js/sidebar": {
                "targetElement": "div.block.block-minicart",
                "url": "<?= $block->getUrl('checkout/cart') ?>",
                "button": ".action.showcart"
            }
        }
    }
    </script>
</div>
