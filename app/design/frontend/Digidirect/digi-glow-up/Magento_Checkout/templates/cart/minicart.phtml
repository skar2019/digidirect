    <script>
        require(['jquery'], function ($) {
            $(function () {
              const $overlay = $('.minicart-overlay')

              function disablePageInteraction() {
                $('body').addClass('overlay-active').css({
                  overflow: 'hidden',
                  'pointer-events': 'none',
                })
              }

              function enablePageInteraction() {
                $('body').removeClass('overlay-active').css({
                  overflow: '',
                  'pointer-events': '',
                })
              }

              function updateOverlayState() {
                const isUpsellActive = $('#pa-upsell').hasClass('active')
                const isMinicartVisible = $('.ui-dialog.mage-dropdown-dialog:visible').has('.block-minicart').length > 0

                if (isUpsellActive || isMinicartVisible) {
                  // Show overlay (only once)
                  $overlay.stop(true, true).show().addClass('active')
                  disablePageInteraction()
                } else {
                  // Hide overlay only when both are inactive
                  $overlay.stop(true, true).hide().removeClass('active')
                  enablePageInteraction()
                }
              }

              // 🧩 Observe #pa-upsell class changes
              const paUpsell = document.getElementById('pa-upsell')
              if (paUpsell) {
                const upsellObserver = new MutationObserver(updateOverlayState)
                upsellObserver.observe(paUpsell, {
                  attributes: true,
                  attributeFilter: ['class'],
                })
              }

              // 🛒 Observe minicart visibility changes
              const minicartObserver = new MutationObserver(() => {
                const $dialog = $('.ui-dialog.mage-dropdown-dialog').has('.block-minicart')
                if (!$dialog.length) return

                // Avoid re-binding
                if ($dialog.data('watching')) return
                $dialog.data('watching', true)

                const dialogObserver = new MutationObserver(updateOverlayState)
                dialogObserver.observe($dialog[0], {
                  attributes: true,
                  attributeFilter: ['style'],
                })
              })

              minicartObserver.observe(document.body, { childList: true, subtree: true })

              // 🧹 Close minicart manually
              $(document).on('click', '.minicart-close', function (e) {
                e.stopPropagation()
                const $dialog = $('.ui-dialog.mage-dropdown-dialog:visible').has('.block-minicart')
                if ($dialog.length) $dialog.hide()
                updateOverlayState()
              })

              // Prevent clicks on overlay from closing minicart or upsell
              $overlay.on('click', function (e) {
                e.stopPropagation()
              })
            })
        })
</script>
