    <!-- 🔹 Custom Toggle Script -->
    <script>
    require(['jquery', 'mage/dropdown'], function ($) {
        $(document).ready(function () {
            const $wrapper = $('.minicart-wrapper');
            const $minicart = $wrapper.find('.block-minicart');
            const $trigger = $wrapper.find('.showcart');
            const $close = $wrapper.find('.minicart-close');
            const $overlay = $wrapper.find('.minicart-overlay');

            function openMinicart() {
                $minicart.dropdownDialog('open');
                $overlay.fadeIn(200);
            }

            function closeMinicart() {
                $minicart.dropdownDialog('close');
                $overlay.fadeOut(200);
            }

            // ✅ Toggle on trigger
            $trigger.on('click', function (e) {
                e.preventDefault();
                if ($minicart.attr('aria-hidden') === 'false') {
                    closeMinicart();
                } else {
                    openMinicart();
                }
            });

            // ✅ Close button
            $close.on('click', function () {
                closeMinicart();
            });

            // ✅ Overlay click
            $overlay.on('click', function () {
                closeMinicart();
            });

            // ✅ ESC key
            $(document).on('keyup', function (e) {
                if (e.key === "Escape") closeMinicart();
            });
        });
    });
    </script>
