                        <path d="M10.23 14.5C9.95 14.5 9.71 14.27 9.71 14V6C9.71 5.73 9.95 5.5 10.23 5.5C10.51 5.5 10.74 5.73 10.74 6V14C10.74 14.27 10.51 14.5 10.23 14.5Z" fill="#F2F2F7"></path>
