<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">

  <body>
    <!-- Use page.main since Algolia replaces content -->
    <referenceContainer name="page.wrapper">
      <block class="Magento\Framework\View\Element\Template"
             name="algolia.deals.custom.block"
             template="Magento_Theme::algolia/landing-page-deals.phtml"
             before="-"/>
    </referenceContainer>

    <!-- Your bottom block stays the same -->
    <referenceContainer name="page.bottom">
      <block class="Digidirect\ParticularAudienceAPI\Block\TestListing"
             template="Digidirect_ParticularAudienceAPI::test-listing.phtml"
             before="global.newsletter"/>
    </referenceContainer>
  </body>
</page>
