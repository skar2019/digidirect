<!-- 🔹 Custom JS -->
<?php
$script = <<<JS
require(['jquery'], function ($) {
  $(function () {
    const \$popup = $('#custom-minicart-popup');
    const \$overlay = $('.custom-minicart-overlay');
    const \$trigger = $('#minicart-trigger');

    function openPopup() {
      \$overlay.fadeIn(200);
      \$popup.fadeIn(200);
    }

    function closePopup() {
      \$overlay.fadeOut(200);
      \$popup.fadeOut(200);
    }

    // Open on trigger
    \$trigger.on('click', function (e) {
      e.preventDefault();
      openPopup();
    });

    // ✅ Delegated close events
    $(document).on('click', '.popup-close, .custom-minicart-overlay', closePopup);

    // ESC key
    $(document).on('keyup', function(e) {
      if (e.key === 'Escape') closePopup();
    });
  });
});
JS;
echo $secureRenderer->renderTag('script', [], $script, false);
?>

