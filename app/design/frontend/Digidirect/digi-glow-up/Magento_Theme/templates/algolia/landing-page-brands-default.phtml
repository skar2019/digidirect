<?php
/** @var \Magento\Framework\View\Element\Template $block */

// Get the current full URL path
$request = $block->getRequest();
$path = trim($request->getOriginalPathInfo(), '/'); // e.g. "brands/apple"

// Extract brand slug after "brands/"
$brand = '';
if (strpos($path, 'brands/') === 0) {
    $brand = substr($path, strlen('brands/')); // "apple"
}

// Sanitize brand (prevent directory traversal etc.)
$brand = preg_replace('/[^a-z0-9\-]/i', '', strtolower($brand));

// Prepare image paths (relative to your theme’s web/images/brands-pages/)
$webImageRelPath    = "images/brands-pages/web/{$brand}.png";
$mobileImageRelPath = "images/brands-pages/mobile/{$brand}.png";

// Get full absolute filesystem path to check if file exists
$pubDir = $block->getViewFileUrl(''); // public base URL
$reader = $block->getViewFileSystem();
$theme  = $block->getDesign()->getDesignTheme();

$existsWeb = false;
$existsMobile = false;

try {
    $webImageFile = $reader->getViewFile($webImageRelPath, ['area' => 'frontend', 'theme' => $theme->getFullPath()]);
    $existsWeb = file_exists($webImageFile);
} catch (\Exception $e) {}

try {
    $mobileImageFile = $reader->getViewFile($mobileImageRelPath, ['area' => 'frontend', 'theme' => $theme->getFullPath()]);
    $existsMobile = file_exists($mobileImageFile);
} catch (\Exception $e) {}

// Fallback if file not found
if (!$existsWeb) {
    $webImageRelPath = 'images/brands-pages/web/default.png';
}
if (!$existsMobile) {
    $mobileImageRelPath = 'images/brands-pages/mobile/default.png';
}

// Generate final URLs
$webImageUrl    = $block->getViewFileUrl($webImageRelPath);
$mobileImageUrl = $block->getViewFileUrl($mobileImageRelPath);
?>

<div class="plp-banner-widget <?= $brand; ?>">
    <div class="plp-banner" style="height: 265px;">
        <img class="banner-web"
             style="height: 100%; object-fit: cover;"
             src="<?= $block->escapeUrl($webImageUrl) ?>"
             alt="<?= $block->escapeHtml($brand ?: 'default') ?>" />

        <img class="banner-mobile"
             style="height: 100%; object-fit: cover; display: none;"
             src="<?= $block->escapeUrl($mobileImageUrl) ?>"
             alt="<?= $block->escapeHtml($brand ?: 'default') ?>" />
    </div>
</div>
