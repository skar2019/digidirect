<?xml version="1.0" encoding="UTF-8"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <link src="Magento_Theme::js/footer.js"/>
    </head>
    <body>
        <referenceContainer name="header.container">
            <container name="header.panel.wrapper" htmlClass="panel wrapper" htmlTag="div" before="-">
                <container name="header.panel" label="Page Header Panel" htmlTag="div" htmlClass="panel header">
                    <block class="Magento\Framework\View\Element\Template" name="glow.up.top.bar" template="Magento_Theme::glow-up-top-bar.phtml"/>  
                    <block class="Magento\Framework\View\Element\Template" name="mobile-navigation-header" template="Magento_Theme::html/mobile-navigation-header.phtml"/>   
                </container>
            </container>
        </referenceContainer>
        
        <referenceBlock name="logo">
            <arguments>
                <argument name="logo_file" xsi:type="string">images/digi-logo.svg</argument>
                <argument name="logo_height" xsi:type="string">49</argument>
                <argument name="logo_width" xsi:type="string">210</argument>
            </arguments>
        </referenceBlock>
        
        <move element="minicart" destination="header-wrapper" after="top.search"/>
        <referenceBlock name="catalog.topnav" remove="true" />
        
        <referenceContainer name="header.container">
            <block class="Magento\Framework\View\Element\Template" name="navigation.menu" template="Magento_Theme::navigation-menu.phtml"/>
        </referenceContainer>
        
        <referenceBlock name="footer_links" remove="true"/>
        <referenceContainer name="footer">
            <container name="footer-links-wrapper" htmlTag="div" htmlClass="footer-content-block" after="footer_links">
                <block class="Magento\Framework\View\Element\Template" name="footer-links" template="Magento_Theme::footer/footer-links.phtml"/>
            </container>
            <block class="Magento\Theme\Block\Html\Footer" name="copyright" template="Magento_Theme::footer/footer-copyright.phtml" />
        </referenceContainer>
    </body>
</page>