<?xml version="1.0"?>
<!--
/**
 * Contact Us Page Layout Override
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">

    <head>
        <title>Contact Us</title>
    </head>

    <body>
        <referenceBlock name="breadcrumbs">
            <action method="addCrumb">
                <argument name="crumbName" xsi:type="string">home</argument>
                <argument name="crumbInfo" xsi:type="array">
                    <item name="label" xsi:type="string">Home</item>
                    <item name="title" xsi:type="string">Home</item>
                    <item name="link" xsi:type="string">/</item>
                </argument>
            </action>
            <action method="addCrumb">
                <argument name="crumbName" xsi:type="string">contact</argument>
                <argument name="crumbInfo" xsi:type="array">
                    <item name="label" xsi:type="string">Contact Us</item>
                    <item name="title" xsi:type="string">Contact Us</item>
                </argument>
            </action>
        </referenceBlock>
        <!-- Header block -->
        <referenceContainer name="columns.top">
            <block class="Magento\Cms\Block\Block" name="contact.us.header">
                <arguments>
                    <argument name="block_id" xsi:type="string">contact-us-header</argument>
                </arguments>
            </block>
        </referenceContainer>

        <!-- Main contact page content -->
        <referenceContainer name="content">
            <container name="contact.page" htmlTag="div" htmlClass="contact-page cms-page">
                <block class="Magento\Contact\Block\ContactForm" name="contactForm" template="Magento_Contact::form.phtml">
                    <container name="form.additional.info" label="Form Additional Info"/>
                </block>
            </container>
        </referenceContainer>
    </body>
</page>
