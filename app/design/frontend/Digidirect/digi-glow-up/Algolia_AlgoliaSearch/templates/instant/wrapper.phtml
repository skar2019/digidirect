<script type="text/javascript">
    require(['jquery', 'mage/loader'], function ($) {
        // Append Magento global loader to body
        var loader = $('<div/>').loader().appendTo('body');

        // Function to show loader
        function showLoader() {
            loader.loader('show');
        }

        // Function to hide loader
        function hideLoader() {
            loader.loader('hide');
        }

        // === Show loader while page is loading ===
        $(document).ready(function() {
            showLoader(); // show immediately
        });

        $(window).on('load', function() {
            hideLoader(); // hide once all content is loaded
        });

        // === Show loader for AJAX product loads (filters, pagination, sorting) ===
        $(document).ajaxStart(function() {
            showLoader();
        });

        $(document).ajaxStop(function() {
            hideLoader();
        });
    });
</script>

