<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <!-- Wrap your facet area -->
            <container name="algolia.facet.wrapper" htmlTag="div" htmlId="algolia-facet-wrapper" before="algolia.instantsearch.container">
                <block class="Magento\Framework\View\Element\Template"
                       name="algolia.custom.facets"
                       template="Magento_Catalog::algolia-facets.phtml"/>
            </container>
        </referenceContainer>
        <referenceBlock name="category.description" remove="true"/>
    </body>
</page>
