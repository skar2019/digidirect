<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <title>Rest Password</title>
    </head>
    <body>
        <referenceContainer name="header.container" remove="true"/>
        <referenceBlock name="header.container" remove="true"/>
        <referenceBlock name="global.newsletter" remove="true"/>
        <referenceContainer name="footer-container" remove="true"/>
        <referenceBlock name="root">
            <action method="setHeaderTitle">
                <argument translate="true" name="title" xsi:type="string">Rest Password</argument>
            </action>
        </referenceBlock>
        <referenceContainer name="content">
            <block class="Magento\Customer\Block\Account\Link" name="customer.backbutton" template="Magento_Customer::form/backbutton.phtml" before="-">
                <arguments>
                    <argument name="label" xsi:type="string" translate="true">Back</argument>
                </arguments>    
            </block>
            <block class="Magento\Framework\View\Element\Template"
            name="login.footer.links"
            template="Magento_Customer::form/login-footer.phtml"
            after="-" />
        </referenceContainer>
    </body>
</page>
