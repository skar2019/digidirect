<?php
/** @var \Magento\Catalog\Block\Product\View\Description $block */
$product = $block->getProduct();

// Load CMS blocks for Delivery & Returns
$deliveryBlock = $block->getLayout()
    ->createBlock(\Magento\Cms\Block\Block::class)
    ->setBlockId('pdp_delivery');

$returnsBlock = $block->getLayout()
    ->createBlock(\Magento\Cms\Block\Block::class)
    ->setBlockId('pdp_returns');
?>

<div class="product-accordion-mobile" id="product-accordion-mobile">
    <!-- Product Description -->
    <div data-role="collapsible">
        <div data-role="trigger">
            <span><?= __('Description') ?></span>
        </div>
    </div>
    <div data-role="content">
         <?= $block->getChildHtml('product-description-mobile'); ?>
    </div>

    <!-- Delivery (CMS static block) -->
    <div data-role="collapsible" class="delivery">
        <div data-role="trigger">
            <span><?= __('Delivery') ?></span>
        </div>
    </div>
    <div data-role="content" class="delivery">
        <?= $deliveryBlock ? $deliveryBlock->toHtml() : ''; ?>
    </div>

    <!-- Returns (CMS static block) -->
    <div data-role="collapsible" class="returns">
        <div data-role="trigger">
            <span><?= __('Returns') ?></span>
        </div>
    </div>
    <div data-role="content" class="returns">
        <?= $returnsBlock ? $returnsBlock->toHtml() : ''; ?>
    </div>
</div>

<script>
    require([
        'jquery',
        'accordion'
    ], function ($) {
        $("#product-accordion-mobile").accordion({
            collapsible: true,
            heightStyle: "content",
            active: "0"
        });
    });
</script>
