                        title="<?= __('Add to Wishlist') ?>"
                        data-post='<?= json_encode([
                            "action" => $block->getUrl('wishlist/index/add'),
                            "data" => [
                                "product" => (int)$_product->getId(),
                                "uenc" => $block->escapeHtmlAttr(base64_encode($block->getUrl('*/*/*', ['_current' => true, '_use_rewrite' => true])))
                            ]
                        ]) ?>'
                        style="padding:6px;box-shadow:0px .78125px .78125px rgba(150,150,150,.09);border-radius:14px;position:absolute;height:25px;width:25px;right:0;margin:12px;border:none;"
