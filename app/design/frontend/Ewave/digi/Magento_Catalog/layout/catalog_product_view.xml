<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="breadcrumbs" remove="false"/>
        <referenceBlock name="view.addto.compare" remove="true" />
        <referenceBlock name="product.info.mailto" remove="true" />
        <referenceBlock name="product.info.overview" remove="true" />
        <referenceBlock name="product.info.addtocart.additional.zipmoney.productimage" remove="true" />

        <!-- in case us/288107-->
        <referenceBlock name="product.attributes" remove="true" />
        <!-- in case us/288107-->

        <move element="breadcrumbs" destination="product.section" before="-"/>
        <move element="page.messages" destination="page.wrapper" before="product.section.wrapper" />

        <move element="page.main.title" destination="product.info.holder" before="-" />
        <move element="product.info.sku" destination="page.main.title" />
        <move element="product.info.review" destination="product.info.holder" after="page.main.title" />
        <move element="product.info.stock.sku" destination="product.info.price" after="-" />
        <move element="product.info.addto" destination="product.info.bottom" />
        <move element="product.info.main" destination="product.view.top" after="-" />
        <move element="product.info.media" destination="product.view.media.overview" before="-" />

        <move element="product.info.details" destination="product.info.media.wrapper" before="-"/>
        <move element="product.info.attachment" destination="product.info.media.bar" after="-"/>

        <move element="catalog.product.related" destination="content" before="-"/>
        <move element="product.info.upsell" destination="content" after="-"/>
        <move element="product.places" destination="product.info.main" after="free_gift_rule_description"/>

        <referenceContainer name="content">
            <container name="product.info.media.wrapper" htmlTag="div" htmlClass="product attributes _negative-gutter" after="product.info.media">
                <container name="product.info.media.bar" htmlTag="div" htmlClass="right-bar">
                    <block class="Magento\Catalog\Block\Product\View\Description" name="product.in.box"
                           template="Magento_Catalog::product/view/in-box.phtml">
                    </block>
                    <block class="Magento\Cms\Block\Block" name="pdp-details-card" after="pdp.cms.details">
                        <arguments>
                            <argument name="block_id" xsi:type="string">pdp-details-card</argument>
                        </arguments>
                    </block>
                </container>
            </container>
            <referenceBlock name="product.info.details" >
                <referenceBlock name="product.info.description">
                    <arguments>
                        <argument name="title" translate="true" xsi:type="string">Description</argument>
                    </arguments>
                </referenceBlock>
                <block class="Magento\Catalog\Block\Product\View\Description" name="product.info.spec" as="spec" template="Magento_Catalog::product/view/specs.phtml" group="detailed_info" after="product.info.description">
                    <arguments>
                        <argument translate="true" name="title" xsi:type="string">Specs</argument>
                    </arguments>
                </block>
            </referenceBlock>
        </referenceContainer>

        <referenceContainer name="page.wrapper">
            <!-- htmlClass "column main" added special for JS swatches logic -->
            <container name="product.section.wrapper" htmlTag="div" htmlClass="product-section column main" before="main.content">
                <container name="product.section" htmlTag="div" htmlClass="section-center">
                    <container name="product.info.holder" htmlTag="div" htmlClass="product-holder">
                        <block class="Magento\Framework\View\Element\Template" name="product.view.bg"
                               after="-"
                               template="Magento_Catalog::product/view/product-bg.phtml">
                        </block>
                    </container>

                    <container name="product.view.top" htmlTag="div" htmlClass="product-basic" after="product.info.holder">
                        <container name="product.view.media.overview" htmlTag="div" htmlClass="media-area">
                            <container name="product.view.overview" htmlTag="div" htmlClass="product-overview" htmlId="productOverview" after="product.info.media">
                                <block class="Magento\Catalog\Block\Product\View\Description" name="pdp.short.description" template="Magento_Catalog::product/view/product-overview.phtml" before="-" >
                                    <block class="Ewave\ExtendedCatalogPriceRule\Block\Pdp\DisplayMessage" as="block_rules" name="pdp.prod.overview.rules" template="Ewave_ExtendedCatalogPriceRule::product/view/description_rule.phtml" />
                                </block>
                            </container>
                        </container>
                    </container>
                </container>
            </container>
        </referenceContainer>

        <referenceContainer name="product.info.media">
            <block class="Magento\Framework\View\Element\Template" before="product.info.media.image"
                   template="Magento_Catalog::product/view/gallery/js-fotorama.phtml">
            </block>
        </referenceContainer>

        <referenceContainer name="product.info.extrahint">
            <container name="product.info.bottom" label="Product Info Bottom container" htmlTag="div"  htmlClass="product-extra" before="-" />
        </referenceContainer>

        <move element="product.info.addtocart.zipmoney.productimage" destination="product.info.bottom" before="-" />

        <referenceBlock name="product.info.upsell">
            <block class="Magento\Cms\Block\Block" name="product.tile.rent">
                <arguments>
                    <argument name="block_id" xsi:type="string">product-tile-rent</argument>
                </arguments>
            </block>
            <block name="product.tile.extended.catalog.rule"
                   class="Ewave\ExtendedCatalogPriceRule\Block\ExtendedRule"
                   template="Ewave_ExtendedCatalogPriceRule::product/view/list/display_message.phtml" />
        </referenceBlock>

        <referenceBlock name="product.info.main">
            <block class="Ewave\ExtendedCatalogPriceRule\Block\Pdp\DisplayMessage"
                   name="ewave.extended.catalog.price.rule.product.view.core"
                   before="-"
                   template="Ewave_ExtendedCatalogPriceRule::product/view/display_message.phtml" />
        </referenceBlock>

        <referenceContainer name="before.body.end">
            <block class="Magento\Framework\View\Element\Template" name="quickview.init" template="Ewave_QuickView::product/list/quickview/quickview.phtml" after="-" ifconfig="ewave_quickview/general/quickview_enabled">
                <arguments>
                    <argument name="use_for_mobile" xsi:type="boolean">true</argument>
                </arguments>
            </block>
        </referenceContainer>

        <container name="product.places" htmlTag="div" htmlClass="product-places">
            <block class="Ewave\Digi\Block\Places" name="product.places.helper"
                   template="Magento_Catalog::product/view/product_places.phtml">
                <block class="Magento\Cms\Block\Block" name="product.delivery.message">
                    <arguments>
                        <argument name="block_id" xsi:type="string">product-detail-delivery-tab-message</argument>
                    </arguments>
                </block>
            </block>
        </container>

        <!--Temporary solution -->
        <referenceBlock name="product.store.availability" remove="true" />
    </body>
</page>
 