<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="head.additional">
            <block class="Magento\Framework\View\Element\Template" name="checkout.ga.js" before="-"
                   template="Magento_Checkout::js/ga.phtml" />
            <block class="Magento\Framework\View\Element\Template" name="checkout.ga.js.customer" template="Magento_Checkout::js/ga-customer.phtml" />
        </referenceBlock>

        <referenceBlock name="page.main.title" remove="true" />
    </body>
</page>
