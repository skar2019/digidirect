<?php /** @var $block \Digidirect\Brands\Block\ListBrands */ ?>
<?php $brands = $block->getBrands(); ?>

<div class="brand-list">
    <?php foreach ($brands as $letter => $items): ?>
        <div class="brand-group" data-letter="<?= $letter ?>">
            <h3><?= $letter ?></h3>
            <ul>
                <?php foreach ($items as $brand): ?>
                    <li class="brand-item" data-name="<?= strtolower($brand['label']) ?>">
                        <a href="<?= $brand['url'] ?>"><?= $brand['label'] ?></a>
                    </li>
                <?php endforeach; ?>
            </ul>
        </div>
    <?php endforeach; ?>
</div>

<style>
.brand-list { display: grid; gap: 24px; }
.brand-group h3 { border-bottom: 1px solid #eee; padding-bottom: 4px; }
.brand-item { list-style: none; margin: 4px 0; }
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const letters = document.querySelectorAll('.brand-alphabet .letter')
  const searchInput = document.getElementById('brand-search')
  const groups = document.querySelectorAll('.brand-group')

  // 🔤 A–Z filter
  letters.forEach(letter => {
    letter.addEventListener('click', () => {
      letters.forEach(l => l.classList.remove('active'))
      letter.classList.add('active')
      const selected = letter.dataset.letter
      groups.forEach(group => {
        const groupLetter = group.dataset.letter
        group.style.display = (selected === 'all' || selected === groupLetter) ? '' : 'none'
      })
    })
  })

  // 🔍 Live search
  searchInput.addEventListener('input', () => {
    const query = searchInput.value.toLowerCase()
    groups.forEach(group => {
      let match = false
      group.querySelectorAll('.brand-item').forEach(item => {
        const name = item.dataset.name
        const visible = name.includes(query)
        item.style.display = visible ? '' : 'none'
        if (visible) match = true
      })
      group.style.display = match ? '' : 'none'
    })
  })
})
</script>
