<?php 
    $objectManager = \Magento\Framework\App\ObjectManager::getInstance();
    $customerSession = $objectManager->create('Magento\Customer\Model\Session');

    if ($customerSession->isLoggedIn()) {
        $customerGroupId = $customerSession->getCustomer()->getGroupId();
        $isDigiClub = 0;
        $isChecked = "";
        if ($customerGroupId == 10) {
            $isDigiClub = 1;
            $isChecked = "checked";
        }
    }
?>

<script>
    require([
        'jquery'
    ],
    function ($) {
        $('#digiclub').change(function() {
            console.log("digiClub!");
            if ($('#digiclub').is(":checked")) {
                $('#digiclub').attr("value", 1);
            } else {
                $('#digiclub').attr("value", 0);
            }
        });
    });
</script>

