<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Digidirect_Faq::config_digidirect_faq" title="Digidirect Faq" translate="title" />
                        </resource>
                    </resource>
                </resource>
                <resource id="Digidirect_Utilities::Digidirect" sortOrder="100">
                    <resource id="Digidirect_Faq::faq" title="Digidirect Faq" sortOrder="10">
                        <resource id="Digidirect_Faq::faq_category" title="Digidirect Faq Category" sortOrder="10">
                            <resource id="Digidirect_Faq::faq_category_items_delete" title="Delete" sortOrder="10" />
                            <resource id="Digidirect_Faq::faq_category_items_save" title="Save" sortOrder="20" />
                        </resource>
                        <resource id="Digidirect_Faq::faqitems" title="Digidirect Faq Items" sortOrder="10">
                            <resource id="Digidirect_Faq::faq_items_delete" title="Delete" sortOrder="10" />
                            <resource id="Digidirect_Faq::faq_faq_items_save" title="Save" sortOrder="20" />
                            <resource id="Digidirect_Faq::faq_faq_items_answer" title="Send answer to customer" sortOrder="30" />
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
