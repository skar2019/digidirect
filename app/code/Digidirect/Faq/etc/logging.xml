<?xml version="1.0"?>
<logging xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Logging:etc/logging.xsd">
    <groups>
        <group name="faq_items">
            <label translate="true">Manage Faq Items</label>
            <expected_models>
                <expected_model class="Digidirect\Faq\Model\Faq" />
            </expected_models>
            <events>
                <event controller_action="digidirect_faq_faq_edit" action_alias="view" />
                <event controller_action="digidirect_faq_faq_save" action_alias="save">
                    <skip_on_back>
                        <controller_action name="digidirect_faq_faq_edit" />
                    </skip_on_back>
                </event>
                <event controller_action="digidirect_faq_faq_delete" action_alias="delete" />
            </events>
        </group>
        <group name="faq_category_items">
            <label translate="true">Manage Faq Category Items</label>
            <expected_models>
                <expected_model class="Digidirect\Faq\Model\Category" />
            </expected_models>
            <events>
                <event controller_action="digidirect_faq_category_edit" action_alias="view" />
                <event controller_action="digidirect_faq_category_save" action_alias="save">
                    <skip_on_back>
                        <controller_action name="digidirect_faq_category_edit" />
                    </skip_on_back>
                </event>
                <event controller_action="digidirect_faq_category_delete" action_alias="delete" />
            </events>
        </group>
    </groups>
</logging>