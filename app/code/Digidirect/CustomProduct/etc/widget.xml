<?xml version="1.0"?>
<widgets xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Widget:etc/widget.xsd">
    <widget id="digidirect_customproduct_list"
            class="Digidirect\CustomProduct\Block\Widget\ProductList"
            is_email_compatible="true">
        <label>Digidirect Product List (Grid / Carousel)</label>
        <description>Display a grid or carousel of products based on SKUs or category.</description>

        <parameters>
            <parameter name="display_mode" xsi:type="select" sort_order="10" visible="true">
                <label>Display Mode</label>
                <options>
                    <option name="grid" value="grid">Grid</option>
                    <option name="carousel" value="carousel">Carousel</option>
                </options>
                <value>grid</value>
            </parameter>

            <parameter name="skus" xsi:type="text" sort_order="20" visible="true">
                <label>Product SKUs (comma-separated)</label>
                    <required>false</required>
            </parameter>

            <parameter name="category_id" xsi:type="text" sort_order="30" visible="true">
                <label>Category ID (optional)</label>
                    <required>false</required>
            </parameter>

            <parameter name="limit" xsi:type="text" sort_order="40" visible="true">
                <label>Product Limit</label>
                    <required>false</required>
                <value>8</value>
            </parameter>

            <parameter name="min_price" xsi:type="text" sort_order="50" visible="true">
                <label>Min Price (optional)</label>
                    <required>false</required>
            </parameter>

            <parameter name="max_price" xsi:type="text" sort_order="60" visible="true">
                <label>Max Price (optional)</label>
                    <required>false</required>
            </parameter>

            <parameter name="title" xsi:type="text" sort_order="70" visible="true">
                <label>Block Title</label>
                    <required>false</required>
            </parameter>
        </parameters>
    </widget>
</widgets>
