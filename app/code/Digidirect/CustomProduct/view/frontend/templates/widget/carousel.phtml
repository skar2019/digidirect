<?php
/** @var $block \Digidirect\CustomProduct\Block\Widget\ProductList */
$collection = $block->getProductCollection();
?>
<div class="digidirect-custom-widget digidirect-custom-carousel">
    <?php if ($block->getData('title')): ?>
        <h2 class="widget-title"><?= $block->escapeHtml($block->getData('title')) ?></h2>
    <?php endif; ?>

    <div class="digidirect-carousel-inner">
        <?php if ($collection->getSize()): ?>
            <?php foreach ($collection as $_product): ?>
                <?php
                // Placeholder logic (same as grid)
                $isDigiMarket      = (bool) $_product->getData('is_digi_market');
                $isDigiSeconds     = (bool) $_product->getData('is_digi_seconds');
                $isDigiOnly        = (bool) $_product->getData('is_digi_only');
                $isDigiPrint       = (bool) $_product->getData('is_digi_print');

                $regularPrice      = (float) $_product->getPrice();
                $finalPrice        = (float) $_product->getFinalPrice();
                $hasCustomFinalPrice = ($finalPrice < $regularPrice);
                $customFinalPrice  = $hasCustomFinalPrice ? number_format($finalPrice, 2) : null;
                $discount          = $hasCustomFinalPrice ? number_format($regularPrice - $finalPrice, 2) : null;

                $isPreorder        = (bool) $_product->getData('is_preorder');
                $isAddToCartEnabled = true;

                $productUrl        = $_product->getProductUrl();
                $imageUrl          = $block->getImageUrl($_product);
                $productName       = $_product->getName();
                $objectID          = $_product->getId();
                ?>
                <div class="carousel-item ais-Hits-item" itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem">
                    <?php if ($isDigiMarket): ?>
                        <div class="ribbon-online">Online only</div>
                    <?php endif; ?>

                    <?php if (!$isDigiSeconds): ?>
                        <?php if ($hasCustomFinalPrice): ?>
                            <?php if ($isDigiOnly): ?>
                                <div class="ribbon-digideals"><span>digi</span>Deals</div>
                            <?php endif; ?>
                        <?php endif; ?>
                    <?php endif; ?>

                    <?php if ($isDigiSeconds): ?>
                        <div class="ribbon-digideals digiseconds"><span style="color: #FE4C25">digi</span>Seconds</div>
                    <?php endif; ?>

                    <div class="result-wrapper" itemprop="item" itemscope itemtype="http://schema.org/Product">
                        <meta itemprop="url" content="<?= $block->escapeUrl($productUrl) ?>"/>
                        <a class="result" href="<?= $block->escapeUrl($productUrl) ?>"
                           data-objectid="<?= (int)$objectID ?>">
                            <div class="result-content">
                                <div class="result-thumbnail">
                                    <?php if ($imageUrl): ?>
                                        <img itemprop="image" src="<?= $block->escapeUrl($imageUrl) ?>" alt="<?= $block->escapeHtmlAttr($productName) ?>" />
                                    <?php else: ?>
                                        <span class="no-image"></span>
                                    <?php endif; ?>
                                </div>

                                <div class="result-sub-content">
                                    <div style="color: #4D4E4E;font-size: 10px;font-weight: 400;word-wrap: break-word;text-align: left;">
                                        <?= $block->escapeHtml($_product->getData('first_category_label') ?: '') ?>
                                    </div>

                                    <h3 itemprop="name" class="result-title text-ellipsis"><?= $block->escapeHtml($productName) ?></h3>

                                    <div class="result-description text-ellipsis"><?= $block->escapeHtml($_product->getShortDescription() ?: '') ?></div>

                                    <div class="s19-rental-price-target">
                                        <?php if ($isDigiPrint): ?>
                                            <p style="font-size: 13px; font-weight: 500;">Order Online Today!</p>
                                        <?php else: ?>
                                            <p style="font-size: 13px; font-weight: 500;">Buy now pay later,</p>
                                            <p style="font-size: 13px; font-weight: 500;">Options Available</p>
                                        <?php endif; ?>
                                    </div>

                                    <div itemprop="offers" itemscope itemtype="<?= $hasCustomFinalPrice ? 'http://schema.org/AggregateOffer' : 'http://schema.org/Offer' ?>" class="price">
                                        <?php if ($hasCustomFinalPrice): ?>
                                            <meta itemprop="lowPrice" content="<?= number_format($finalPrice, 2, '.', '') ?>" />
                                            <meta itemprop="highPrice" content="<?= number_format($regularPrice, 2, '.', '') ?>" />
                                        <?php else: ?>
                                            <meta itemprop="price" content="<?= number_format($regularPrice, 2, '.', '') ?>" />
                                        <?php endif; ?>
                                        <meta itemprop="priceCurrency" content="<?= $block->escapeHtmlAttr($block->getStore()->getCurrentCurrencyCode()) ?>" />

                                        <?php if ($hasCustomFinalPrice): ?>
                                            <div class="price-wrapper">
                                                <span class="price-container">
                                                    <?php if ($_product->getData('default_original_price')): ?>
                                                        <span class="price"><?= $block->escapeHtml($_product->getData('default_original_price')) ?></span>
                                                    <?php else: ?>
                                                        <span class="price"><?= $block->escapeHtml(number_format($regularPrice, 2)) ?></span>
                                                    <?php endif; ?>
                                                </span>
                                                <div>
                                                    <span class="after_special custom_final_price"><?= $block->escapeHtml($customFinalPrice) ?></span>
                                                </div>
                                            </div>
                                        <?php else: ?>
                                            <div class="price-wrapper">
                                                <span class="price-container">
                                                    <span class="price"></span>
                                                </span>
                                                <div>
                                                    <span class="after_special"><?= $block->escapeHtml(number_format($regularPrice, 2)) ?></span>
                                                </div>
                                            </div>
                                        <?php endif; ?>

                                    </div>

                                    <div class="product-info-bottom">
                                        <?php if ($hasCustomFinalPrice): ?>
                                            <div class="discount-price-wrapper">
                                                <span class="discount-price"><?= $block->escapeHtml($discount) ?></span> Off
                                            </div>
                                        <?php else: ?>
                                            <div class="discount-price-wrapper-no-price"></div>
                                        <?php endif; ?>

                                        <?php if ($isAddToCartEnabled): ?>
                                            <?php if (!$isDigiPrint): ?>
                                                <form data-role="tocart-form" action="<?= $block->getUrl('checkout/cart/add') ?>" method="post">
                                                    <input type="hidden" name="product" value="<?= (int)$objectID ?>">
                                                    <input name="form_key" type="hidden" value="<?= $block->getFormKey() ?>">
                                                    <button type="submit" title="<?= __('Add to Cart') ?>" class="action tocart primary" data-objectid="<?= (int)$objectID ?>">
                                                        <?php if (!$isPreorder): ?>
                                                            <span><?= __('Add to Cart') ?></span>
                                                            <img src="<?= $block->getViewFileUrl('images/icons/cart.png') ?>" alt="" />
                                                        <?php else: ?>
                                                            <span><?= __('Pre-Order') ?></span>
                                                        <?php endif; ?>
                                                    </button>
                                                </form>
                                            <?php else: ?>
                                                <div class="actions-primary">
                                                    <a class="ordernow-link" href="<?= $block->escapeUrl($_product->getData('digiprint_url') ?: '#') ?>" target="_blank">
                                                        <button type="button" title="<?= __('Order Now') ?>" class="action tocart primary"><?= __('Order Now') ?></button>
                                                    </a>
                                                </div>
                                            <?php endif; ?>
                                        <?php endif; ?>
                                    </div>

                                </div><!-- result-sub-content -->
                            </div><!-- result-content -->
                        </a>
                    </div><!-- result-wrapper -->
                </div><!-- carousel-item -->
            <?php endforeach; ?>
        <?php else: ?>
            <p class="no-products"><?= __('No products found') ?></p>
        <?php endif; ?>
    </div><!-- digidirect-carousel-inner -->

    <!-- Optional: small inline init hint (remove if you init elsewhere) -->
    <script>
        // Example: init your slider for .digidirect-carousel-inner here (requires slider library)
        // initSlider('.digidirect-carousel-inner');
    </script>
</div>
