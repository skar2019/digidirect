<script>
	require(['jquery'], function ($) {
		$(document).ready(function () {

			$("#tradeupForm").submit(function (e) {
				let allRequired = true;
				let requiredFields = $(this).find('input[required]');

				requiredFields.each(function () {
					if ($(this).val() == '') {
						allRequired = false;
						$(this).css('border-color', 'red');
					} else {
						$(this).css('border-color', '#e0e0e0');
					}
				});

				if (!allRequired) {
					alert("Please fill up the required fields.");
					e.preventDefault();
					return false;
				}

				/*let emailVal = $("#email").val();
				let emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
				if (!emailRegex.test(emailVal)) {
					alert("Please enter a valid email address.");
					e.preventDefault();
					return false;
				}*/

				if ($("input[type=checkbox]:checked").length === 0) {
					alert("You must check at least one accessory.");
					e.preventDefault();
					return false;
				}
			});

			const range = document.getElementById("conditionRange");
			if (range) {
				updateConditionBubble(range.value);
			}
		});
	});

	function updateConditionBubble(val) {
		document.getElementById("ratingValue").value = val;

		const range = document.getElementById("conditionRange");
		const bubble = document.getElementById("rangeBubble");

		const min = range.min ? range.min : 1;
		const max = range.max ? range.max : 6;
		const newVal = Number(((val - min) * 100) / (max - min));

		bubble.innerHTML = val;
		bubble.style.left = `calc(${newVal}%)`;
	}

	function setRating(val) {
		const range = document.getElementById("conditionRange");
		range.value = val;
		updateConditionBubble(val);
	}
</script>
