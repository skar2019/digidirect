<?php
$helper = $this->helper('Digidirect\TradeUp\Helper\Data');
$isEnabled = $helper->isTradeUPFromEnabled();
$showForm = true;

$request = $this->getRequest();

if ($isEnabled && $request->isPost()) {

	// $recipient_email = 'newseller@digidirect.com.au'; //recipient email address
	// $recipient_email = 'tradeandsave@digidirect.com.au'; // Updated recipient
	$recipient_email = $helper->getRecipientEmail();
	$post = $request->getPostValue();

	$firstname = $post["firstname"] ?? '';
	$lastname = $post["lastname"] ?? '';
	$email = $post["email"] ?? '';
	$phonenumber = $post["phonenumber"] ?? '';
	// $descriptiongoods = $post["descriptiongoods"] ?? ''; // Comment
	$shuttercount = $post["shuttercount"] ?? '';
	$rate = $post['rate'] ?? '';
	$accessories = isset($post['accessories']) ? implode(", ", $post['accessories']) : '';
	$miscellaneousaccessories = $post["miscellaneousaccessories"] ?? ''; // General

	//Get uploaded file data using Request object
	$files = $request->getFiles('attachment');
	$tmp_name = $files['tmp_name'] ?? '';
	$name = $files['name'] ?? '';
	$size = $files['size'] ?? 0;
	$type = $files['type'] ?? '';

	//Load POST data from HTML form
	$Fullname = $firstname . " " . $lastname; //sender name
	$subject = "Trade Up Form"; //subject for the email
	$message = "\n" . "\n"
		. "Fullname :" . "\t" . $Fullname . "\n"
		. "Email :" . "\t" . $email . "\n"
		. "Contact Number :" . "\t" . $phonenumber . "\n"
		. "Rate :" . "\t" . $rate . "\n"
		. "Included Accessories :" . "\t" . $accessories . "\n"
		. "General :" . "\t" . $miscellaneousaccessories . "\n"
		. "Shutter Count :" . "\t" . $shuttercount . "\n" . "\n";


	if (empty($tmp_name)) {
		$boundary = md5("random");
		$headers = "MIME-Version: 1.0\r\n";
		$headers .= "From:" . $email . "\r\n";
		$headers .= "Content-Type: multipart/mixed;";
		$headers .= "boundary = $boundary\r\n";

		$body = "--$boundary\r\n";
		$body .= "Content-Type: text/plain; charset=ISO-8859-1\r\n";
		$body .= "Content-Transfer-Encoding: base64\r\n\r\n";
		$body .= chunk_split(base64_encode($message));

	} else {
		$handle = fopen($tmp_name, "r");
		$content = fread($handle, $size);
		fclose($handle);

		$encoded_content = chunk_split(base64_encode($content));
		$boundary = md5("random");

		$headers = "MIME-Version: 1.0\r\n";
		$headers .= "From:" . $email . "\r\n";
		$headers .= "Content-Type: multipart/mixed;";
		$headers .= "boundary = $boundary\r\n";

		$body = "--$boundary\r\n";
		$body .= "Content-Type: text/plain; charset=ISO-8859-1\r\n";
		$body .= "Content-Transfer-Encoding: base64\r\n\r\n";
		$body .= chunk_split(base64_encode($message));

		$body .= "--$boundary\r\n";
		$body .= "Content-Type: $type; name=" . $name . "\r\n";
		$body .= "Content-Disposition: attachment; filename=" . $name . "\r\n";
		$body .= "Content-Transfer-Encoding: base64\r\n";
		$body .= "X-Attachment-Id: " . rand(1000, 99999) . "\r\n\r\n";
		$body .= $encoded_content;
	}

	$sentMailResult = mail($recipient_email, $subject, $body, $headers);

	if ($sentMailResult) {
		//echo "<p class='successmessage message success'>Successfully Sent. Thank You" . "</p>";
		//echo "<div id='tradeup_success' class='container' style='text-align:center; padding: 40px;'><h3 class='successmessage' style='color: green;'>Successfully Sent. Thank You.</h3></div>";
		$showForm = false;

        echo "<script>
            require(['jquery'], function($) {
                $(document).ready(function() {
                    var successMsg = '<div class=\"message-success success message\" style=\"margin-bottom: 20px;\"><div>Successfully Sent. Thank You</div></div>';
                    var target = $('main#maincontent');
                    if (target.length === 0) target = $('.page-main');
                    if (target.length === 0) target = $('body');

                    target.prepend(successMsg);
                    $('html, body').animate({ scrollTop: 0 }, 'slow');
                });
            });
        </script>";
	} else {
		echo "<script>alert('Sorry but the email could not be sent. Please try again!');</script>";
	}
}
