<?php
$helper = $this->helper('Digidirect\TradeUp\Helper\Data');
$isEnabled = $helper->isTradeUPFromEnabled();
$showForm = true;

$request = $this->getRequest();

if ($isEnabled && $request->isPost()) {

	$post = $request->getPostValue();

	$firstname = $post["firstname"] ?? '';
	$lastname = $post["lastname"] ?? '';
	$email = $post["email"] ?? '';
	$phonenumber = $post["phonenumber"] ?? '';
	$shuttercount = $post["shuttercount"] ?? '';
	$rateNumber = $post['rate'] ?? '';
	$accessories = isset($post['accessories']) ? implode(", ", $post['accessories']) : '';
	$miscellaneousaccessories = $post["miscellaneousaccessories"] ?? '';

	// Map numeric rating to text label
	$rateLabels = [
		'1' => 'Inoperable',
		'2' => 'Fair',
		'3' => 'Good',
		'4' => 'Very Good',
		'5' => 'Excellent',
		'6' => 'Perfect'
	];
	$rate = isset($rateLabels[$rateNumber]) ? $rateLabels[$rateNumber] : '';

	$files = $request->getFiles('attachment');

	$formData = [
		'fullname' => $firstname . " " . $lastname,
		'email' => $email,
		'phonenumber' => $phonenumber,
		'rate' => $rate,
		'accessories' => $accessories,
		'miscellaneousaccessories' => $miscellaneousaccessories,
		'shuttercount' => $shuttercount
	];

	$fileData = [
		'tmp_name' => $files['tmp_name'] ?? '',
		'name' => $files['name'] ?? '',
		'type' => $files['type'] ?? ''
	];

	$sentMailResult = $helper->sendTradeUpEmail($formData, $fileData);

	if ($sentMailResult) {
		$showForm = false;

		echo "<script>
            require(['jquery'], function($) {
                $(document).ready(function() {
                    var successMsg = '<div class=\"message-success success message\" style=\"margin-bottom: 20px;\"><div>Your Trade-In request has been received and will be answered on the next business day. Thank you!</div></div>';
                    var target = $('main#maincontent');
                    if (target.length === 0) target = $('.page-main');
                    if (target.length === 0) target = $('body');

                    target.prepend(successMsg);
                    $('html, body').animate({ scrollTop: 0 }, 'slow');
                });
            });
        </script>";
	} else {
		echo "<script>alert('Sorry but the email could not be sent. Please try again!');</script>";
	}
}
