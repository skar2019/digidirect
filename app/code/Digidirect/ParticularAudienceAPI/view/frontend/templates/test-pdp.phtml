    function viewProduct(productId) {
        
        var date = new Date();

        const viewProductData = {
            customerId: configCustomerId,
            sessionId: configSessionId,
            events: [
                {
                    currentUrl: currentUrl,
                    eventTime: date.toISOString(),
                    refId: productId
                }
            ]
        };

        //console.log("viewProductData", JSON.stringify(viewProductData));

        $.ajax({
            async: false,
            url: "https://www.digidirect.com.au/particularaudienceapi/events/viewproduct",
            type: "POST",
            data: {
                eventData: viewProductData
            },
            success: function(data){
                console.log(data);
            },
            error: function(){
                console.log('AJAX Fail!');
            }
