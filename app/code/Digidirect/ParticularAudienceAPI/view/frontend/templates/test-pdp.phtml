    function getCookie(name) {
        const value = `; ${document.cookie}`;
        const parts = value.split(`; ${name}=`);
        if (parts.length === 2) return parts.pop().split(';').shift();
    }
    
    var customerId = getCookie('PAC');
    var sessionId = getCookie('pa_session_id');
    
    if (!sessionId || sessionId === undefined) {
        $.ajax({
            async: false,
            url: "https://www.digidirect.com.au/particularaudienceapi/index/getconfig",
            type: "POST",
            data: {
                customerId: customerId
            },
            success: function(data){
                console.log(data);
                customerId = data.payload.customerId;
                sessionId = data.payload.session.id
            },
            error: function(){
                console.log('AJAX Get Config Fail!');
            }
        });
    }
    
    var result;

    $.ajax({
        async: false,
        url: "https://www.digidirect.com.au/particularaudienceapi/index/productpage", //getRecommendationsUrl,
        type: "POST",
        data: {
            customerId: customerId,
            productId: <?= $productId; ?>
        },
        success: function(data){
            result = data;
        },
        error: function(){
            console.log('AJAX Fail!');
        }
    });
    
    console.log('result', result);
