<?php
    use Magento\Framework\App\Action\Action;
?>
<script>
    
require(['jquery'], function ($) {
    
    function getCookie(name) {
        const value = `; ${document.cookie}`;
        const parts = value.split(`; ${name}=`);
        if (parts.length === 2) return parts.pop().split(';').shift();
    }
    
    console.log('PAC: ' + getCookie('PAC'));
    var customerId = getCookie('PAC');
    var customerParam = "";
    
    if (customerId) {
        customerParam = "&customerId=" + customerId;
    }
    
    const getRecommendationsUrl = "https://api-recs.particularaudience.com/3.0/recommendations?currentUrl=https://www.digidirect.com.au/pa-digi-home-page&expandProductDetails=false"+customerParam;
    const accessToken = "<?= $block->getBearerToken() ?>"; // Replace with your actual access token

    var result;

    $.ajax({
        async: false,
        url: getRecommendationsUrl,
        headers: {
            'Authorization': `Bearer ${accessToken}`,
            'Content-Type': "application/json"
        },
        type: "GET",
        success: function(data){
            result = data;
            console.log('success: ' + data);
        },
        error: function(){
            console.log('AJAX Fail!');
        }
    });
    
    console.log('result: ' + JSON.stringify(result));
    var recommendationsResult = result;
    var widgets  = recommendationsResult.recommendations.route.widgets;
    //console.log('routeId: ' + widgets);

    /*Object.keys(widgets).forEach(key => {
      console.log(key, widgets[key]);
    });*/

    var blueWidget = widgets.find(obj => {
        return obj.id === '458d80ed-033e-ec11-aae9-02dca44cceec';
    })

    //console.log(blueWidget);

    var blueWidgetArr = [];
    var blueWidgetSlots = blueWidget.slots;
    Object.keys(blueWidgetSlots).forEach(key => {
        console.log(key, blueWidgetSlots[key].products[0].refId);
        blueWidgetArr.push(blueWidgetSlots[key].products[0].refId);
    });

    console.log(blueWidgetArr);
    
});

</script>

