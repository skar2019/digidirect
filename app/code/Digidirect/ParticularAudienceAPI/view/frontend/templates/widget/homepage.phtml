<script>
    
require(['jquery'], function ($) {
    
    function getCookie(name) {
        const value = `; ${document.cookie}`;
        const parts = value.split(`; ${name}=`);
        if (parts.length === 2) return parts.pop().split(';').shift();
    }
    console.log('PAC: ' + getCookie('PAC'));
    var customerId = getCookie('PAC');
    var customerParam = "";
    
    if (customerId) {
        customerParam = "&customerId=" + customerId;
    }
    
    const getRecommendationsUrl = "https://api-recs.particularaudience.com/3.0/recommendations?currentUrl=https://www.digidirect.com.au/pa-digi-home-page&expandProductDetails=false"+customerParam;
    const accessToken = "<?= $block->getBearerToken() ?>"; // Replace with your actual access token

    var result;

    $.ajax({
        async: false,
        url: getRecommendationsUrl,
        headers: {
            'Authorization': `Bearer ${accessToken}`,
            'Content-Type': "application/json"
        },
        type: "GET",
        success: function(data){
            result = data;
            console.log('success: ' + data);
        },
        error: function(){
            console.log('AJAX Fail!');
        }
    });
    
    console.log('result: ' + JSON.stringify(result));
    var recommendationsResult = JSON.stringify(result);
    var routeId  = recommendationsResult['recommendations']['route'][0]['id'];
    console.log('routeId: ' + routeId);
        
});

</script>

