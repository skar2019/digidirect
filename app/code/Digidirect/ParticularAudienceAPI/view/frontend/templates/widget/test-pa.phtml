   $('.owl-carousel.custom').on('changed.owl.carousel initialized.owl.carousel', function (event) {
        let $carousel = $(this);
        let $items = $carousel.find('.owl-item');

        // Get all active indexes
        let activeIndexes = [];
        $items.each(function (i) {
            if ($(this).hasClass('active')) activeIndexes.push(i);
        });

        // Target range: 4–8 (0-based, so this is 5th–9th)
        let expectedRange = [3, 4, 5, 6, 7];

        // Check if activeIndexes exactly match expectedRange
        let onlyWithinRange =
            activeIndexes.length === expectedRange.length &&
            activeIndexes.every((val, idx) => val === expectedRange[idx]);

        if (onlyWithinRange) {
            console.log('✅ Only items 3-6 are active');
            $carousel.find('.owl-next').addClass('unclickable');
        } else {
            console.log('❌ Active items are different:', activeIndexes);
            $carousel.find('.owl-next').removeClass('unclickable');
        }
    });

