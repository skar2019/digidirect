            var $a = $wrapper.find("a.owl-video");
            if ($a.length) return; // already has link = still thumbnail

            var videoUrl = $wrapper.closest(".owl-item").attr("data-video");
            var videoId = videoUrl.split("v=")[1].split("&")[0];
            var thumb = "https://img.youtube.com/vi/" + videoId + "/hqdefault.jpg";

            // Restore thumbnail view
            $wrapper.html(
                '<a class="owl-video" href="' + videoUrl + '" data-thumb="' + thumb + '" style="display:none;"></a>' +
                '<div class="owl-video-play-icon"></div>' +
                '<div class="owl-video-tn" style="background-image:url(' + thumb + '); background-size:cover; background-position:center;"></div>'
            );
        });
    }

    // Handle play clicks
    $(".owl-carousel.featured-videos").on("click", ".owl-video-play-icon", function () {
        var $carousel = $(this).closest(".owl-carousel.featured-videos");

        // reset all before playing new
        resetOwlVideos($carousel);

        var $wrapper = $(this).closest(".owl-video-wrapper");
        var videoUrl = $wrapper.closest(".owl-item").attr("data-video");
        var videoId = videoUrl.split("v=")[1].split("&")[0];

        var iframe = '<iframe width="100%" height="100%" ' +
            'src="https://www.youtube.com/embed/' + videoId + '?autoplay=1" ' +
            'frameborder="0" allow="autoplay; encrypted-media" allowfullscreen>' +
            '</iframe>';

        $wrapper.html(iframe);
    });


});

</script>

