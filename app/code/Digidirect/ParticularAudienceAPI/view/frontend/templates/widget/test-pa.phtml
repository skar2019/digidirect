            async: false,
            url: "<?= $block->getBaseUrl(); ?>particularaudienceapi/index/getconfig",
            type: "POST",
            data: {
                customerId: customerId
            },
            success: function(data){
                console.log(data);
                customerId = data.payload.customerId;
                sessionId = data.payload.session.id;
            },
            error: function(data){
                console.log('Config Error!', data);
            }
        });
    }
    
