<script>

    function loadMoreProducts(widgetClass) {
        var hiddenTiles = document.querySelectorAll('.'+ widgetClass + ' ' + ' .hide-product-item');
        var ctr = 0;
        for (let x = 0; x < hiddenTiles.length; x++) {
          ctr++;
          hiddenTiles[x].classList.remove('hide-product-item');
          if (ctr == 4) break;
        }
        var hiddenTilesCount = document.querySelectorAll('.'+ widgetClass + ' ' + ' .hide-product-item');
        if (hiddenTilesCount.length == 0) {
            document.querySelectorAll('.'+ widgetClass + ' ' + '.load-more')[0].style.display = "none";
            document.querySelectorAll('.'+ widgetClass + ' ' + '.view-less')[0].style.display = "block";

            try {
                document.querySelectorAll('.'+ widgetClass + ' ' + '.view-all')[0].style.display = "block";
            }
            catch(err) {
            }
        }
    }

    function viewLessProducts(widgetClass) {
        var productTiles = document.querySelectorAll('.'+ widgetClass + ' ' + '.mobile-widget .product-item');

        var ctr = 0;
        for (let x = 0; x < productTiles.length; x++) {
          ctr++;
          if (ctr > 4) {
             productTiles[x].classList.add('hide-product-item');
          }
        }

        document.querySelectorAll('.'+ widgetClass + ' ' + '.load-more')[0].style.display = "block";
        document.querySelectorAll('.'+ widgetClass + ' ' + '.view-less')[0].style.display = "none";
        try {
            document.querySelectorAll('.'+ widgetClass + ' ' + '.view-all')[0].style.display = "none";
        }
        catch(err) {
        }
        document.getElementById(widgetClass).scrollIntoView();

    }

    function viewAllProducts(viewAllLink) {
        window.location.href = viewAllLink;
    }


</script>

<script type="text/javascript">
    require(['jquery'], function ($) {
        $(document).ready(function () {
            var $grid = $('.digiservices-grid');
            var $cards = $grid.find('.digiservice-card');
            if (!$grid.length || !$cards.length) return;
            function masonryLayout() {
                var gridWidth = $grid.width();
                var columnCount = 3;
                if ($(window).width() <= 1024) columnCount = 3;
                if ($(window).width() <= 767) {
                    //$grid.hide();
                    columnCount = 1;
                    return;
                } else {
                    $grid.show();
                }
                var columnHeights = new Array(columnCount).fill(0);
                var gap = 24;
                var cardWidth = (gridWidth - gap * (columnCount - 1)) / columnCount;
                $cards.each(function () {
                    var $card = $(this);
                    $card.css('width', cardWidth + 'px');
                    var minColumn = columnHeights.indexOf(Math.min.apply(Math, columnHeights));
                    var x = (cardWidth + gap) * minColumn;
                    var y = columnHeights[minColumn];
                    $card.css({
                        transform: 'translate(' + x + 'px,' + y + 'px)'
                    });
                    columnHeights[minColumn] += $card.outerHeight(true) + gap;
                });
                $grid.css('height', Math.max.apply(Math, columnHeights) + 'px');
            }
            function imagesLoaded($images, callback) {
                var loaded = 0, count = $images.length;
                if (count === 0) return callback();
                $images.each(function () {
                    if (this.complete) {
                        if (++loaded === count) callback();
                    } else {
                        $(this).on('load error', function () {
                            if (++loaded === count) callback();
                        });
                    }
                });
            }
            imagesLoaded($grid.find('img'), function() {
                masonryLayout();
                $grid.css('opacity', 1);
            });
            $(window).on('resize', masonryLayout);
        });
    });
</script>
