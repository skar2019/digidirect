                        console.log('🦉 Initializing OwlCarousel for minicart...')
                        $carousel.owlCarousel({
                            loop: false,
                            nav: true,
                            margin: 15,
                            touchDrag: true,
                            mouseDrag: true,
                            smartSpeed: 800,
                            slideBy: 1,
                            responsive: {
                                0: { items: 2 },
                                600: { items: 2 },
                                768: {items:3},
                                992: { items: 3 },
                                1024: { items: 4 },
                                1310: { items: 4 },
                                1366: { items: 4 },
                                1550: { items: 4 }
                            },
                            dots: false,
                            autoplay: false,
                            autoplayTimeout: 3000
                        })
                    }
                }, 800)
                instance.disconnect()
            }
        })

        // 🎯 Observe the minicart container (use document.body as fallback)
        const target = document.querySelector('.block-minicart') || document.body
        observer.observe(target, config)

        // ⏰ Stop after 10s just in case
        setTimeout(() => observer.disconnect(), 10000)
    })()

