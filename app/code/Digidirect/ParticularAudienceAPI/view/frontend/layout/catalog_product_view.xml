<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="page.wrapper">
            <block class="Digidirect\ParticularAudienceAPI\Block\TestPdp" template="Digidirect_ParticularAudienceAPI::test-pdp.phtml" />
        </referenceContainer>
        <referenceBlock name="product.info.main">
            <block class="Digidirect\ParticularAudienceAPI\Block\PdpDigiMarketSidePanel" 
                   name="pa.digimarket.side.panel" 
                   template="Digidirect_ParticularAudienceAPI::pa-digimarket-side-panel.phtml" 
                   before="page.main.title" />
        </referenceBlock>
        <referenceContainer name="content">
            <block class="Digidirect\ParticularAudienceAPI\Block\PdpDigiMarketSidePanel" 
                   name="pa.digimarket.widget" 
                   template="Digidirect_ParticularAudienceAPI::pa-digimarket-widget.phtml" 
                   before="-" />
            <block class="Digidirect\ParticularAudienceAPI\Block\PdpFrequentlyBoughtWith" 
                   name="pa.frequently.bought.with" 
                   template="Digidirect_ParticularAudienceAPI::pa-frequently-bought-with.phtml" 
                   before="-" />
            <block class="Magento\Framework\View\Element\Template" 
                   name="pa.also.viewed.widget" 
                   template="Digidirect_ParticularAudienceAPI::pa-also-viewed-widget.phtml" 
                   before="-" />
        </referenceContainer>
    </body>
</page>
