<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="digidirect_customoptions">
        <job name="customoptions_deleteoptions" instance="Digidirect\CustomOptions\Cron\DeleteOptions" method="execute">
            <schedule>40 23 * * *</schedule>
        </job>
        <job name="customoptions_createoptions" instance="Digidirect\CustomOptions\Cron\CreateOptions" method="execute">
            <schedule>55 23 * * *</schedule>
        </job>
    </group>
</config>