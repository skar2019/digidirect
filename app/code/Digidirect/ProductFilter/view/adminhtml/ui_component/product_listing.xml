<?xml version="1.0" encoding="UTF-8"?>

<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <listingToolbar name="listing_top">
        <filters name="listing_filters">
            <filterSelect name="backorders_options" provider="${ $.parentName }" component="Magento_Ui/js/form/element/ui-select" template="ui/grid/filters/elements/ui-select">
                <settings>
                    <options class="Magento\CatalogInventory\Model\Source\Backorders"/>
                    <caption translate="true">Select...</caption>
                    <label translate="true">Backorders</label>
                    <dataScope>backorders_options</dataScope>
                    <imports>
                        <link name="visible">componentType = column, index = ${ $.index }:visible</link>
                    </imports>
                </settings>
            </filterSelect>
        </filters>
    </listingToolbar>
    <columns name="product_columns" class="Magento\Catalog\Ui\Component\Listing\Columns">
        <column name="backorders_options" class="Digidirect\ProductFilter\Ui\Component\Listing\Columns\Backorders" sortOrder="76">
            <settings>
                <addField>true</addField>
                <dataType>select</dataType>
                <sortable>false</sortable>
                <label translate="true">Backorders</label>
            </settings>
        </column>
    </columns>
</listing>
