<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Magento\Catalog\Model\Product" type="Digidirect\Catalog\Model\Product" />
    
    <preference for="Magento\Catalog\Helper\Product\Configuration" type="Digidirect\Catalog\Helper\Product\Configuration" />

    <type name="Magento\Catalog\Model\Config">
        <plugin name="sortby_add_custom_option" type="Digidirect\Catalog\Plugin\Model\Config" />
    </type>
    <type name="Magento\Catalog\Block\Product\ProductList\Toolbar">
        <plugin name="sortby_extend_default_sort_filters" type="Digidirect\Catalog\Plugin\Block\Toolbar" />
    </type>
    <type name="Magento\Checkout\Model\Cart">
        <plugin name="add_product_to_cart" type="Digidirect\Catalog\Plugin\RedirectToCheckout" sortOrder="10" disabled="false"/>
    </type>
    <type name="Magento\Cms\Model\Wysiwyg\Images\Storage">
        <arguments>
            <argument name="extensions" xsi:type="array">
                <item name="allowed" xsi:type="array">
                    <item name="pdf" xsi:type="number">1</item>
                </item>
            </argument>
        </arguments>
    </type>
    <preference for="Magento\Cms\Model\Wysiwyg\Images\Storage" type="Digidirect\Catalog\Model\Cms\Wysiwyg\Images\Storage" />
</config>