        <plugin name="override_robots" type="Digidirect\Catalog\Plugin\Robots"/>
    </type>
    <type name="Magento\Catalog\Pricing\Price\FinalPrice">
        <plugin name="wiser_finalprice" type="Digidirect\Catalog\Plugin\Pricing\Price\FinalPrice" />
    </type>
    <type name="Magento\Framework\View\Result\Page">
        <plugin name="digiprinit_class" type="Digidirect\Catalog\Plugin\Result\Page"/>
    </type>
    <type name="Magento\Checkout\Model\Cart">
        <plugin name="digidirect_order_limit_validation" type="Digidirect\Catalog\Plugin\Checkout\OrderLimitValidation" sortOrder="10"/>
    </type>
</config>
