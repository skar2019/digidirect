<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Magento\Catalog\Model\Product" type="Digidirect\Catalog\Model\Product" />
    <preference for="Magento\Catalog\Helper\Product\Configuration" type="Digidirect\Catalog\Helper\Product\Configuration" />
    <preference for="Magento\Catalog\Block\Category\View" type="Digidirect\Catalog\Block\Category\View" />
    
    <type name="Magento\Quote\Model\Quote\Item">
        <plugin name="freegift_price" type="Digidirect\Catalog\Plugin\Quote\Item"/>
    </type>
    <type name="Magento\Catalog\Model\Config">
        <plugin name="sortby_add_custom_option" type="Digidirect\Catalog\Plugin\Model\Config" />
    </type>
    <type name="Magento\Catalog\Block\Product\ProductList\Toolbar">
        <plugin name="sortby_extend_default_sort_filters" type="Digidirect\Catalog\Plugin\Block\Toolbar" />
    </type>
    <type name="Magento\Catalog\Pricing\Price\FinalPrice">
        <plugin name="wiser_finalprice" type="Digidirect\Catalog\Plugin\Pricing\Price\FinalPrice" />
    </type>
    <type name="Magento\Catalog\Api\Data\ProductRepositoryInterface">
        <plugin name="custom_sku_limit" type="Digidirect\Catalog\Plugin\ProductRepositoryPlugin"/>
    </type>
</config>
