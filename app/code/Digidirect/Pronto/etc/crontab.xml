<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="digidirect_pronto">
        <job name="pronto_order_sync" instance="Digidirect\Pronto\Cron\SendOrder" method="execute">
            <schedule>*/2 * * * *</schedule>
        </job>
        <job name="pronto_inventory_sync" instance="Digidirect\Pronto\Cron\InventoryEnquiry" method="execute">
            <schedule>*/10 * * * *</schedule>
        </job>
        <job name="pronto_product_sync" instance="Digidirect\Pronto\Cron\ProductEnquiry" method="execute">
            <schedule>0 0 * * *</schedule>
        </job>
        <job name="pronto_test_sync" instance="Digidirect\Pronto\Cron\OrderTest" method="execute">
            <schedule>0 1 * * *</schedule>
        </job>
        <job name="pronto_shipping_sync" instance="Digidirect\Pronto\Cron\ProntoShipping" method="execute">
            <schedule>*/15 * * * *</schedule>
        </job>
        <job name="pronto_productstock_sync" instance="Digidirect\Pronto\Cron\CronStockStatusUpdate" method="execute">
            <schedule>0 2 * * *</schedule>
        </job>
        
    </group>
</config>