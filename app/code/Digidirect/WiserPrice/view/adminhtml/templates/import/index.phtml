<script>
require([
    'jquery',
    'mage/mage',
    'mage/validation'
], function($) {
    $('#wiserprice_import_form').mage('validation', {});
    
    $('#csv_file').on('change', function() {
        var fileName = $(this).val().split('\\').pop();
        var fileExtension = fileName.split('.').pop().toLowerCase();
        
        if (fileExtension !== 'csv') {
            alert('<?= $block->escapeJs(__('Please select a CSV file.')) ?>');
            $(this).val('');
        }
    });
});
</script>

