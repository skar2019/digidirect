<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp/etc/csp_whitelist.xsd">
    <policies>
        <policy id="script-src">
            <values>
                <!--CDN-->
                <value id="cloudflare" type="host">*.cloudflare.com</value>

                <!--Google-->
                <value id="google-analytics" type="host">www.google-analytics.com</value>

                <!--Functions-->
                <value id="cloudfront" type="host">*.cloudfront.net</value>
                <value id="testfreaks" type="host">*.testfreaks.com</value>
                <value id="cfjump" type="host">*.cfjump.com</value>
                <value id="fbevents" type="host">*.facebook.net</value>
                <value id="benchmarketingsmarttag" type="host">*benchplatform.com</value>
                <value id="livechat" type="host">*livechatinc.com</value>
                <value id="googleadsviewthroughconversion" type="host">*.g.doubleclick.net</value>
                <value id="googletagmanager" type="host">googletagmanager.com</value>
                <value id="adsrvr" type="host">*.adsrvr.org</value>
                <value id="studio19" type="host">*.studio19.com.au</value>
                <value id="particularaudience" type="host">*.particularaudience.com</value>
                <value id="wisepops" type="host">*.wisepops.com</value>
                <value id="stackadapt" type="host">*.srv.stackadapt.com</value>
                <value id="newrelic" type="host">*.newrelic.com</value>
                <value id="bamcell" type="host">*.nr-data.net</value>

            </values>
        </policy>
        <policy id="style-src">
            <values>
                <!--CDN-->
                <value id="cloudflare" type="host">*.cloudflare.com</value>

                <!--Design-->
                <value id="typekit" type="host">*.typekit.net</value>

                <!--Functions-->
                <value id="trustedshops" type="host">*.trustedshops.com</value>
                <value id="usercentrics" type="host">*.usercentrics.eu</value>
            </values>
        </policy>
        <policy id="img-src">
            <values>
                <!--CDN-->
                <value id="cloudflare" type="host">*.cloudflare.com</value>
                <value id="klarna-base" type="host">https://cdn.klarna.com</value>

                <!--Payments-->
                <value id="paypal" type="host">*.paypal.com</value>

                <!--Video-->
                <value id="vimeocdn" type="host">*.vimeocdn.com</value>
                <value id="youtube-img" type="host">https://s.ytimg.com</value>

                <!--Functions-->
                <value id="usercentrics" type="host">*.usercentrics.eu</value>
            </values>
        </policy>
        <policy id="connect-src">
            <values>
                <!--CDN-->
                <value id="cloudflare" type="host">*.cloudflare.com</value>

                <!--Payments-->
                <value id="paypal" type="host">*.paypal.com</value>
            </values>
        </policy>
        <policy id="font-src">
            <values>
                <!--CDN-->
                <value id="cloudflare" type="host">*.cloudflare.com</value>

                <!--Design-->
                <value id="typekit" type="host">*.typekit.net</value>

                <!--Functions-->
                <value id="trustedshops" type="host">*.trustedshops.com</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>