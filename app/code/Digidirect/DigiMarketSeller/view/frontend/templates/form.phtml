<div id="digimarketseler_form">
        <div class="container" >
            <header>Submit a request to join the digiDirect Marketplace</header>

                <form id="sellerForm" name="frm" class="form-horizontal" method="post" enctype="multipart/form-data" action="<?php echo $this->getUrl("digimarketseller/index/index")?>">
                    
                    <label for="fname">First Name</label>
                    <input type="text" id="fname" name="fname">
                    
                    <?=$block->getChildHtml('form.additional.info') ?>
                    <input type="hidden" name="hideit" id="hideit" value="" />
                    <button type="submit" id="add" title="" class="action submit primary next">
                        <span><?= $block->escapeHtml(__('SUBMIT')) ?></span>
                    </button>
                </form>
        </div>
</div>

<script>
require(['jquery'],function($){

    $(document).ready(function(){
        $("#add").click(function(){
        var customurl = "<?php echo $this->getUrl("digimarketseller/index/index") ?>";

        $.ajax({
            url: customurl,
            type: "POST",
            data: $(this).closest('form').serialize(),
            dataType: "json",
            success: function(result){
                console.log(result);
            }
        });
        $('#sellerForm')[0].reset(); 
        return false;
        });
    });


}); 


</script>
 