<script>
require(['jquery'],function($){

    $(document).ready(function(){
        $("#add").click(function(){
        var customurl = "<?php echo $this->getUrl("digimarketseller/index/index") ?>";

        $.ajax({
            url: customurl,
            type: "POST",
            data: $(this).closest('form').serialize(),
            dataType: "json",
            success: function(result){
                console.log(result);
            }
        });
        $('#sellerForm')[0].reset(); 
        return false;
        });
    });


}); 


</script>
 