<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Order email for logged-in users -->
    <type name="Magento\Sales\Model\Order\Email\Container\OrderIdentity">
        <plugin name="digidirect_order_email_template"
                type="Digidirect\Sales\Plugin\OrderEmailTemplatePlugin" />
    </type>

    <!-- Order email for guest checkout -->
    <type name="Magento\Sales\Model\Order\Email\Container\GuestOrderIdentity">
        <plugin name="digidirect_guest_order_email_template"
                type="Digidirect\Sales\Plugin\OrderEmailTemplatePlugin" />
    </type>

</config>
