<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_quote_collect_totals_before">
        <observer name="ewave_gift_collect_totals_before" instance="Ewave\FreeGift\Observer\FixWholeCartRuleObserver"/>
    </event>
    <event name="sales_quote_collect_totals_after">
        <observer name="ewave_gift_collect_totals_after" instance="Ewave\FreeGift\Observer\CollectTotalsAfterObserver"/>
    </event>
    <event name="sales_quote_remove_item">
        <observer name="ewave_gift_quote_remove_item" instance="Ewave\FreeGift\Observer\QuoteRemoveItemObserver"/>
    </event>
    <event name="layout_load_before">
        <observer name="ewave_gift_layout_load_before" instance="Ewave\FreeGift\Observer\Frontend\LoadLayoutBefore"/>
    </event>
    <event name="controller_action_predispatch_sales_order_reorder">
        <observer name="ewave_gift_controller_action_predispatch_sales_order_reorder"
                  instance="Ewave\FreeGift\Observer\Frontend\ControllerActionPredispatchSalesOrderReorder"/>
    </event>
    <event name="controller_action_predispatch_checkout_index_index">
        <observer name="ewave_gift_controller_action_predispatch_checkout_index_index"
                  instance="Ewave\FreeGift\Observer\Frontend\ControllerActionPredispatchCheckoutIndexIndex"/>
    </event>
    <event name="checkout_cart_product_add_after">
        <observer name="ewave_gift_checkout_cart_product_add_after"
                  instance="Ewave\FreeGift\Observer\Frontend\CheckoutCartProductAddAfter"/>
    </event>
</config>
