<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Ewave\ProductPriority\Model\PriorityFactory">
        <arguments>
            <argument name="sortTypes" xsi:type="array">
                <item name="revenue" xsi:type="object">Ewave\ProductPriority\Model\Priority\Sort\RevenueSort</item>
                <item name="number_of_sale" xsi:type="object">Ewave\ProductPriority\Model\Priority\Sort\NumberOfSalesSort</item>
                <item name="margin" xsi:type="object">Ewave\ProductPriority\Model\Priority\Sort\MarginSort</item>
            </argument>
        </arguments>
    </type>
    <type name="Ewave\ProductPriority\Model\Priority\CalculateAbstract">
        <arguments>
            <argument name="reIndexTypes" xsi:type="array">
                <item name="0" xsi:type="string">catalog_category_product</item>
                <item name="1" xsi:type="string">catalog_product_category</item>
                <item name="2" xsi:type="string">catalog_product_attribute</item>
            </argument>
        </arguments>
    </type>
</config>

