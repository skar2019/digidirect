<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="adminhtml.widget.instance.grid">
            <block class="Magento\Backend\Block\Widget\Grid\Massaction" name="adminhtml.block.widget.instance.massactions" as="grid.massaction">
                <arguments>
                    <argument name="massaction_id_field" xsi:type="string">instance_id</argument>
                    <argument name="form_field_name" xsi:type="string">widget</argument>
                    <argument name="use_select_all" xsi:type="string">1</argument>
                    <argument name="options" xsi:type="array">
                        <item name="generate_upgrade_script" xsi:type="array">
                            <item name="label" xsi:type="string" translate="true">Generate Upgrade Script</item>
                            <item name="url" xsi:type="string">ewavecmsupgrade/widget/generate</item>
                            <item name="confirm" xsi:type="string" translate="true">Are you sure you want to generate Upgrade Script?</item>
                        </item>
                    </argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>