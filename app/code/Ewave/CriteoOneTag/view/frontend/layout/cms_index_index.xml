        <referenceBlock name="before.body.end">
            <block class="Ewave\CriteoOneTag\Block\HomePage" name="ewave.criteo.home"
                   template="Ewave_CriteoOneTag::onetag.phtml">
                <arguments>
                    <argument name="page_type" xsi:type="string">HomePage</argument>
