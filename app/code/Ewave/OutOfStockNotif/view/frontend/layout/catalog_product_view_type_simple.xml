<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="product.info.main">
            <block class="Magento\Catalog\Block\Product\View" name="in.stock.notification" template="Ewave_OutOfStockNotif::product/in-stock.phtml">
                <arguments>
                    <argument name="html_class" xsi:type="string">stock ewave-out-of-stock-notification</argument>
                    <argument translate="true" name="button_label" xsi:type="string">Notify me when in stock</argument>
                    <argument translate="true" name="signup_label" xsi:type="string">Email Address</argument>
                    <argument name="modal_options" xsi:type="array">
                        <item name="type" xsi:type="string">popup</item>
                        <item name="title" xsi:type="string" translate="true">Notify Me</item>
                        <item name="modalClass" xsi:type="string">outofstock-modal</item>
                        <item name="buttons" xsi:type="array"/>
                    </argument>
                    <argument translate="true" name="backorder_button_label" xsi:type="string">Back-order</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
