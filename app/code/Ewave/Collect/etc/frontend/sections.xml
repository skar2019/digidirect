<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Customer:etc/sections.xsd">
    <action name="checkout/cart/add">
        <section name="ewave_collect"/>
    </action>
    <action name="checkout/cart/delete">
        <section name="ewave_collect"/>
    </action>
    <action name="checkout/cart/updatePost">
        <section name="ewave_collect"/>
    </action>
    <action name="checkout/cart/updateItemOptions">
        <section name="ewave_collect"/>
    </action>
    <action name="rest/*/V1/collectplace/delivery/all">
        <section name="ewave_collect"/>
    </action>
    <action name="rest/*/V1/collectplace/apply/all">
        <section name="ewave_collect"/>
    </action>
</config>
