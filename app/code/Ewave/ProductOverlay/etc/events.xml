<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="ewave_productoverlay_save_after">
        <observer name="Ewave_ProductOverlay::UpdateAttributeValue" instance="Ewave\ProductOverlay\Observer\AfterSaveObserver" />
    </event>
    <event name="ewave_productoverlay_delete_after">
