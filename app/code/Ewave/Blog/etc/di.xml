<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Ewave\Blog\Api\Data\PostInterface" type="Ewave\Blog\Model\Post" />
    <preference for="Ewave\Blog\Api\PostRepositoryInterface" type="Ewave\Blog\Model\PostRepository" />
    <preference for="Ewave\Blog\Api\Data\CategoryInterface" type="Ewave\Blog\Model\Category" />
    <preference for="Ewave\Blog\Api\CategoryRepositoryInterface" type="Ewave\Blog\Model\CategoryRepository" />
    <preference for="Ewave\Blog\Api\Data\TagInterface" type="Ewave\Blog\Model\Tag" />
    <preference for="Ewave\Blog\Api\Data\CommentInterface" type="Ewave\Blog\Model\Comment" />
    <preference for="Ewave\Blog\Api\CommentRepositoryInterface" type="Ewave\Blog\Model\CommentRepository" />
    <preference for="Ewave\Blog\Api\TagRepositoryInterface" type="Ewave\Blog\Model\TagRepository" />
    <virtualType name="Ewave\Blog\Model\Config\Source\CommentType" type="Ewave\Blog\Model\Config\AbstractSource">
        <arguments>
            <argument name="providerList" xsi:type="array">
                <item name="default" xsi:type="object">\Ewave\Blog\Model\Config\Provider\CommentType</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="Ewave\Blog\Model\Config\Source\PageListType" type="Ewave\Blog\Model\Config\AbstractSource">
        <arguments>
            <argument name="providerList" xsi:type="array">
                <item name="default" xsi:type="object">\Ewave\Blog\Model\Config\Provider\PageListType</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="Ewave\Blog\Model\Config\Source\PageLayout" type="Ewave\Blog\Model\Config\AbstractSource">
        <arguments>
            <argument name="providerList" xsi:type="array">
                <item name="default" xsi:type="object">\Ewave\Blog\Model\Config\Provider\PageLayout</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="Ewave\Blog\Model\Config\Source\Sorting" type="Ewave\Blog\Model\Config\AbstractSource">
        <arguments>
            <argument name="providerList" xsi:type="array">
                <item name="default" xsi:type="object">\Ewave\Blog\Model\Config\Provider\SortingType</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="Ewave\Blog\Model\Config\Source\Status" type="Ewave\Blog\Model\Config\AbstractSource">
        <arguments>
            <argument name="providerList" xsi:type="array">
                <item name="default" xsi:type="object">\Ewave\Blog\Model\Config\Provider\Status</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="blog_post_grid_data_source" xsi:type="string">Ewave\Blog\Model\ResourceModel\Post\Grid\Collection</item>
                <item name="blog_category_grid_data_source" xsi:type="string">Ewave\Blog\Model\ResourceModel\Category\Grid\Collection</item>
                <item name="blog_comment_grid_data_source" xsi:type="string">Ewave\Blog\Model\ResourceModel\Comment\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
    <type name="Ewave\Blog\Model\ResourceModel\Post\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">ewave_blog_post</argument>
            <argument name="eventPrefix" xsi:type="string">ewave_blog_post_grid_collection</argument>
            <argument name="eventObject" xsi:type="string">blog_post_grid_collection</argument>
            <argument name="resourceModel" xsi:type="string">Ewave\Blog\Model\ResourceModel\Post</argument>
        </arguments>
    </type>
    <type name="Ewave\Blog\Model\ResourceModel\Category\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">ewave_blog_category</argument>
            <argument name="eventPrefix" xsi:type="string">ewave_blog_category_grid_collection</argument>
            <argument name="eventObject" xsi:type="string">blog_category_grid_collection</argument>
            <argument name="resourceModel" xsi:type="string">Ewave\Blog\Model\ResourceModel\Category</argument>
        </arguments>
    </type>
    <type name="Ewave\Blog\Model\ResourceModel\Comment\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">ewave_blog_comment</argument>
            <argument name="eventPrefix" xsi:type="string">ewave_blog_comment_grid_collection</argument>
            <argument name="eventObject" xsi:type="string">blog_comment_grid_collection</argument>
            <argument name="resourceModel" xsi:type="string">Ewave\Blog\Model\ResourceModel\Comment</argument>
        </arguments>
    </type>
    <type name="Magento\Framework\EntityManager\MetadataPool">
        <arguments>
            <argument name="metadata" xsi:type="array">
                <item name="Ewave\Blog\Api\Data\PostInterface" xsi:type="array">
                    <item name="entityTableName" xsi:type="string">ewave_blog_post</item>
                    <item name="identifierField" xsi:type="string">entity_id</item>
                </item>
            </argument>
        </arguments>
    </type>
    <type name="Ewave\Blog\Model\ImageProcessor">
        <arguments>
            <argument name="imageUploader" xsi:type="object">Ewave\Blog\PostImageUpload</argument>
        </arguments>
    </type>
    <virtualType name="Ewave\Blog\PostImageUpload" type="Ewave\Blog\Model\ImageUploader">
        <arguments>
            <argument name="baseTmpPath" xsi:type="string">ewave_blog/tmp/post</argument>
            <argument name="basePath" xsi:type="string">ewave_blog/post</argument>
            <argument name="allowedExtensions" xsi:type="array">
                <item name="jpg" xsi:type="string">jpg</item>
                <item name="jpeg" xsi:type="string">jpeg</item>
                <item name="gif" xsi:type="string">gif</item>
                <item name="png" xsi:type="string">png</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Ewave\Blog\Model\Widget\Options\Template">
        <arguments>
            <argument name="options" xsi:type="array">
                <item name="default" xsi:type="array">
                    <item name="label" xsi:type="string">Default</item>
                </item>
                <item name="custom" xsi:type="array">
                    <item name="label" xsi:type="string">Custom</item>
                </item>
            </argument>
        </arguments>
    </type>
    <type name="Ewave\Utilities\Model\Sitemap">
        <plugin name="blogAddSiteMapItems" type="Ewave\Blog\Plugin\Sitemap\Model\Sitemap"/>
    </type>
</config>
