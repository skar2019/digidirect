<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="svgi.js" remove="true" /><!-- Remove old implementation of SVG (from Ewave_Utilities) -->

        <referenceBlock name="head.additional">
            <!-- Fonts -->
            <block class="Magento\Framework\View\Element\Template" name="js_fonts" template="Magento_Theme::js/fonts.phtml" before="-">
                <arguments>
                    <argument name="fonts_active" xsi:type="boolean">true</argument><!-- Enable/disable custom font logic -->
                    <argument name="fonts_is_inline" xsi:type="boolean">false</argument><!-- Enable/disable inline version of script -->
                    <argument name="fonts_css" xsi:type="string">css/fonts.css</argument>
                    <argument name="fonts_css_min" xsi:type="string">css/fonts.min.css</argument>
                    <argument name="fonts_revision" xsi:type="string">1.0.0</argument><!-- Developer revision -->
                    <argument name="fonts_script_url" xsi:type="string">js/components/fonts.js</argument>
                </arguments>
                <block class="Magento\Framework\View\Element\Template" name="js_fonts_inline" as="js.fonts.inline" template="Magento_Theme::js/fonts-inline.phtml"/>
            </block>
        </referenceBlock>

        <referenceContainer name="after.body.start">
            <!-- Lazy -->
            <block class="Magento\Framework\View\Element\Template" name="js_lazy" template="Magento_Theme::js/lazy.phtml" before="-">
                <arguments>
                    <argument name="lazy_active" xsi:type="boolean">false</argument><!-- Enable/disable lazy loading logic -->
                </arguments>
            </block>
            <!-- SVG -->
            <block class="Magento\Framework\View\Element\Template" name="svg_sprite" template="Magento_Theme::js/svg-sprite.phtml" before="-">
                <arguments>
                    <argument name="svg_active" xsi:type="boolean">true</argument><!-- Enable/disable SVG logic -->
                    <argument name="svg_is_inline" xsi:type="boolean">false</argument><!-- Enable/disable inline version of script -->
                    <argument name="svg_url" xsi:type="string">svg/sprite.svg</argument>
                    <argument name="svg_revision" xsi:type="string">1.0.0</argument><!-- Developer revision for update localStorage -->
                    <argument name="svg_script_url" xsi:type="string">js/components/svg-sprite.js</argument>
                    <argument name="svg_class_name" xsi:type="string">svg-sprite</argument>
                </arguments>
                <block class="Magento\Framework\View\Element\Template" name="svg_sprite_inline" as="svg.sprite.inline" template="Magento_Theme::js/svg-sprite-inline.phtml"/>
            </block>
            <block class="Magento\Framework\View\Element\Template" name="data_post_init" template="Magento_Theme::js/data-post.phtml" before="-" />
        </referenceContainer>

        <referenceContainer name="before.body.end">
            <block class="Magento\Framework\View\Element\Template" name="back-to-top" template="Magento_Theme::html/back-to-top.phtml" after="-">
                <arguments>
                    <argument name="text" xsi:type="string" translate="true">To Top</argument>
                    <argument name="title" xsi:type="string" translate="true">Back to top</argument>
                    <argument name="css_class" xsi:type="string">back-top</argument>
                    <argument name="always_visible" xsi:type="boolean">false</argument>
                    <argument name="always_visible_class" xsi:type="string">-visible</argument>
                    <argument name="anchor_id" xsi:type="string"/>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
