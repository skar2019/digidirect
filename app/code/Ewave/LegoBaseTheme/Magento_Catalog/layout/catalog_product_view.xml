<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="catalog.product.related">
            <block class="Magento\Catalog\Block\Product\ProductList\Item\Container" name="tocart.form" as="tocart_form"/>
            <block class="Magento\Catalog\Block\Product\ProductList\Item\Container" name="product_details_before_price_related"/>
        </referenceBlock>
        <referenceBlock name="product.info.upsell">
            <block class="Magento\Catalog\Block\Product\ProductList\Item\Container" name="tocart.form" as="tocart_form"/>
            <block class="Magento\Catalog\Block\Product\ProductList\Item\Container" name="product_details_before_price_upsell"/>
        </referenceBlock>
        <referenceBlock name="product.info.media.image">
            <arguments>
                <argument name="show_first_image" xsi:type="boolean">true</argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
