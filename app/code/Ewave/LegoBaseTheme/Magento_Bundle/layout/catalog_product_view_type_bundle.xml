<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="product.info.bundle.options.select">
            <arguments>
                <argument name="is_enable_bundle_images" xsi:type="boolean">true</argument>
            </arguments>
            <block class="Magento\Framework\View\Element\Template" name="product.info.bundle.option.additional" as="product.info.bundle.option.additional"
                   template="Magento_Catalog::product/view/additional/info.phtml" />
            <block class="Magento\Framework\View\Element\Template" name="product.info.bundle.option.select.selection" as="product.info.bundle.option.select.selection"
                   template="Magento_Bundle::catalog/product/view/type/bundle/selection.phtml" />
        </referenceBlock>

        <referenceBlock name="product.info.bundle.options.multi">
            <arguments>
                <argument name="is_enable_bundle_images" xsi:type="boolean">true</argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="product.info.bundle.options.radio">
            <arguments>
                <argument name="is_enable_bundle_images" xsi:type="boolean">true</argument>
            </arguments>
            <block class="Magento\Framework\View\Element\Template" name="product.info.bundle.option.additional" as="product.info.bundle.option.additional"
                   template="Magento_Catalog::product/view/additional/info.phtml" />
            <block class="Magento\Framework\View\Element\Template" name="product.info.bundle.option.radio.selection" as="product.info.bundle.option.radio.selection"
                   template="Magento_Bundle::catalog/product/view/type/bundle/selection.phtml" />
        </referenceBlock>

        <referenceBlock name="product.info.bundle.options.checkbox">
            <arguments>
                <argument name="is_enable_bundle_images" xsi:type="boolean">true</argument>
            </arguments>
            <block class="Magento\Framework\View\Element\Template" name="product.info.bundle.option.checkbox.selection" as="product.info.bundle.option.checkbox.selection"
                   template="Magento_Bundle::catalog/product/view/type/bundle/selection.phtml" />
        </referenceBlock>
    </body>
</page>
