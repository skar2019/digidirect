<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="product.info.price">
            <block class="Ewave\ExtendedCatalogPriceRule\Block\Pdp\DisplayMessage"
                   name="ewave.extended.catalog.price.rule.product.view"
                   as="ewave_extended_catalog_rule_pdp"
                   template="Ewave_ExtendedCatalogPriceRule::product/view/price_rule.phtml"
                   after="product.price.final" />
        </referenceContainer>
        <referenceBlock name="product_details_before_price_related">
            <block name="ewave_extended_catalog_rule_pdp_related"
                   class="Ewave\ExtendedCatalogPriceRule\Block\ExtendedRule"
                   template="Ewave_ExtendedCatalogPriceRule::product/view/list/display_message.phtml"/>
        </referenceBlock>
        <referenceBlock name="product_details_before_price_upsell">
            <block name="ewave_extended_catalog_rule_pdp_upsell"
                   class="Ewave\ExtendedCatalogPriceRule\Block\ExtendedRule"
                   template="Ewave_ExtendedCatalogPriceRule::product/view/list/display_message.phtml"/>
        </referenceBlock>
    </body>
</page>
