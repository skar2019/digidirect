<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- set has special price to product -->
    <event name="sales_quote_address_collect_totals_before">
        <observer name="Ewave_ExtendedCartPriceRules::sales_quote_address_collect_totals_before"
                  instance="Ewave\ExtendedCartPriceRules\Observer\SalesQuoteAddressCollectTotalsBefore"/>
    </event>

    <event name="checkout_submit_before">
        <observer name="Ewave_ExtendedCartPriceRules::CheckoutSubmitBefore"
                  instance="Ewave\ExtendedCartPriceRules\Observer\CheckoutSubmitBefore"/>
    </event>
    <event name="sales_quote_collect_totals_after">
        <observer name="Ewave_ExtendedCartPriceRules::SalesQuoteCollectTotalsAfter"
                  instance="Ewave\ExtendedCartPriceRules\Observer\SalesQuoteCollectTotalsAfter"/>
    </event>

    <event name="sales_quote_load_after">
        <observer name="Ewave_ExtendedCartPriceRules::SalesQuoteLoadAfter"
                  instance="Ewave\ExtendedCartPriceRules\Observer\SalesQuoteLoadAfter"/>
    </event>

    <event name="sales_model_service_quote_submit_before">
        <observer name="Ewave_ExtendedCartPriceRules::SalesModelServiceQuoteSubmitBefore"
                  instance="Ewave\ExtendedCartPriceRules\Observer\SalesModelServiceQuoteSubmitBefore"/>
    </event>
</config>
