<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Ewave\Banner\Model\Widget\BannerRotator\Config">
        <arguments>
            <argument name="config" xsi:type="array">
                <item name="fields" xsi:type="array">
                    <item name="0" xsi:type="string">rotation_speed</item>
                    <item name="1" xsi:type="string">loop</item>
                    <item name="2" xsi:type="string">breadcrumbs_type</item>
                    <item name="3" xsi:type="string">autoplay</item>
                </item>
            </argument>
        </arguments>
    </type>


    <preference for="Magento\Banner\Block\Adminhtml\Banner\Edit\Tab\Content" type="Ewave\Banner\Preference\Magento\Banner\Block\Adminhtml\Banner\Edit\Tab\Content" />

        <!-- DONE -->
    <preference for="Magento\Banner\Controller\Adminhtml\Banner\Save" type="Ewave\Banner\Controller\Adminhtml\Banner\Save" />
        <!-- EOF DONE -->

    <type name="Magento\Banner\Model\ResourceModel\Banner">
        <plugin name="add-banner-attributes-after-load-admin" type="Ewave\Banner\Plugin\Magento\Banner\Model\ResourceModel\AdminBanner" />
    </type>
    <type name="Magento\Backend\Block\Widget\Form\Element\Dependence">
        <plugin type="Ewave\Banner\Plugin\Magento\Backend\Block\Widget\Form\Element\Dependence" name="customize-banner-rotator-dependence" />
    </type>
    <type name="Magento\Framework\Data\Form\Element\AbstractElement">
        <plugin type="Ewave\Banner\Plugin\Magento\Framework\Data\Form\AbstractElement" name="remove-form-prefix-for-product-search" />
    </type>
    <type name="Ewave\Banner\Model\Attributes">
        <plugin name="copy-alt-text-from-banner-name" type="Ewave\Banner\Plugin\Model\Attributes" />
    </type>
    <type name="Magento\Banner\Model\Banner\DataProvider">
        <plugin name="banner-edit-form-data-provider" type="Ewave\Banner\Plugin\Model\Banner\DataProvider" />
    </type>
    <type name="Ewave\Banner\Block\Adminhtml\Banner\Edit\Tab\Properties">
        <arguments>
            <argument name="skipWidgetClass" xsi:type="string">Magento\Banner\Block\Widget\Banner</argument>
        </arguments>
    </type>

    <!-- EOF PREFERENCES -->
    
    <!-- STATIC BANNER ALLOWANCE IN WYSIWYG -->
    <type name="Magento\Widget\Controller\Adminhtml\Widget\BuildWidget">
        <plugin name="modify_banner_parameters" type="Ewave\Banner\Plugin\Magento\Widget\Controller\Adminhtml\Widget\BuildWidget" />
    </type>
    <!-- EOF -->

</config>