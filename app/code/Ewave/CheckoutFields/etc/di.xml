<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Ewave\CheckoutFields\Model\Config\Data">
        <arguments>
            <argument name="reader" xsi:type="object">Ewave\CheckoutFields\Model\Config\Reader</argument>
            <argument name="cacheId" xsi:type="string">checkout_fields</argument>
        </arguments>
    </type>
    <type name="Ewave\CheckoutFields\Model\Config\Reader">
        <arguments>
            <argument name="converter" xsi:type="object">Ewave\CheckoutFields\Model\Config\Converter</argument>
            <argument name="schemaLocator" xsi:type="object">Ewave\CheckoutFields\Model\Config\SchemaLocator</argument>
            <argument name="fileName" xsi:type="string">checkout_fields.xml</argument>
        </arguments>
    </type>
    <preference for="Ewave\CheckoutFields\Api\PdpFieldValueInterface"
                type="Ewave\CheckoutFields\Model\PdpFieldValue"/>
    <preference for="Ewave\CheckoutFields\Api\PdpFieldValueRepositoryInterface"
                type="Ewave\CheckoutFields\Model\PdpFieldValueRepository"/>
    <preference for="Ewave\CheckoutFields\Api\Data\QuoteFieldValueInterface"
                type="Ewave\CheckoutFields\Model\QuoteFieldValue"/>
    <preference for="Ewave\CheckoutFields\Api\QuoteFieldValueRepositoryInterface"
                type="Ewave\CheckoutFields\Model\QuoteFieldValueRepository"/>
    <preference for="Ewave\CheckoutFields\Api\OrderFieldValueRepositoryInterface"
                type="Ewave\CheckoutFields\Model\OrderFieldValueRepository"/>
    <preference for="Ewave\CheckoutFields\Api\QuoteFieldValueManagementInterface"
                type="Ewave\CheckoutFields\Model\QuoteFieldValueManagement"/>

    <type name="Magento\Quote\Model\QuoteRepository\LoadHandler">
        <plugin name="Ewave_CheckoutFields::PluginMagentoQuoteModelQuoteRepositoryLoadHandlerPlugin" type="Ewave\CheckoutFields\Plugin\Magento\Quote\Model\QuoteRepository\LoadHandlerPlugin"/>
    </type>
    <type name="Magento\Quote\Api\PaymentMethodManagementInterface">
        <plugin name="Ewave_CheckoutFields::PluginMagentoQuoteApiPaymentMethodManagementInterface" type="Ewave\CheckoutFields\Plugin\Magento\Quote\Model\PaymentMethodManagementPlugin"/>
    </type>


    <preference for="Ewave\CheckoutFields\Api\CustomFieldsInterface"
                type="Ewave\CheckoutFields\Model\Service\CustomFields"/>

    <type name="Ewave\CheckoutFields\Helper\Xml\Fields\Parser">
        <arguments>
            <argument name="validationRuleMapping" xsi:type="array">
                <item name="min_text_length" xsi:type="string">minlength</item>
                <item name="max_text_length" xsi:type="string">maxlength</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="updateCheckoutFieldsByDate" xsi:type="object">Ewave\CheckoutFields\Console\Command\UpdateCheckoutFieldsByString</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Sales\Api\OrderRepositoryInterface">
        <plugin name="OrderCheckoutFieldsPlugin" type="Ewave\CheckoutFields\Plugin\Model\Order\RepositoryPlugin"/>
    </type>
</config>
