<?xml version="1.0" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Ewave\MyStoreWidget\Api\MyStoreRepositoryInterface" type="Ewave\MyStoreWidget\Model\MyStoreRepository"/>
    <preference for="Ewave\MyStoreWidget\Api\Data\MyStoreSearchResultsInterface" type="Magento\Framework\Api\SearchResults"/>
    <preference for="Ewave\MyStoreWidget\Api\Data\MyStoreInterface" type="Ewave\MyStoreWidget\Model\MyStore"/>

    <type name="Ewave\MyStoreWidget\Model\ResourceModel\MyStoreIndex">
        <arguments>
            <argument name="rangeAttributes" xsi:type="array">
                <item name="postcode" xsi:type="string">postcode</item>
            </argument>
        </arguments>
    </type>

    <type name="Ewave\MyStoreWidget\Helper\Data">
        <arguments>
            <argument name="customerSessionFactory" xsi:type="object">Ewave\MyStoreWidget\Model\Customer\SessionFactory</argument>
        </arguments>
    </type>
    <type name="Ewave\MyStoreWidget\Block\MyStore">
        <arguments>
            <argument name="customerSessionFactory" xsi:type="object">Ewave\MyStoreWidget\Model\Customer\SessionFactory</argument>
        </arguments>
    </type>
</config>
