<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/preorders/:sku" method="GET">
        <service class="Bss\PreOrder\Api\PreOrderRepositoryInterface" method="checkIsPreOrderProduct"/>
        <resources>
            <resource ref="anonymous" />
        </resources>
    </route>
    <route url="/V1/preorders" method="GET">
        <service class="Bss\PreOrder\Api\PreOrderRepositoryInterface" method="getListPreOrderProduct"/>
        <resources>
            <resource ref="anonymous" />
        </resources>
    </route>
</routes>
