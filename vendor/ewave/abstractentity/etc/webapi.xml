<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">

    <route url="/V1/abstractentity/:id" method="GET">
        <service class="Ewave\AbstractEntity\Api\Rest\AbstractEntityRestInterface" method="getById"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>

    <route url="/V1/abstractentity/:id/attributes/:attributes" method="GET">
        <service class="Ewave\AbstractEntity\Api\Rest\AbstractEntityRestInterface" method="getById"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>

</routes>
