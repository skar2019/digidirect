<?xml version="1.0"?>
<layout xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_layout.xsd">
    <referenceContainer name="before.body.end">
        <block name="ewave_extendedcart.ajax_update"
               ifconfig="ewave_extendedcart/cart_page/use_ajax_for_cart_update"
               class="Magento\Framework\View\Element\Template"
               template="Ewave_ExtendedCart::checkout/cart_update.phtml">
            <action method="setAjaxUpdateBlockNames">
                <argument name="value" xsi:type="array">
                    <item name="#form-validate" xsi:type="string">checkout.cart.form</item>
                </argument>
            </action>
        </block>
    </referenceContainer>
</layout>
