<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="ewave_extendedcart" translate="label" type="text" sortOrder="161800" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Extended Cart</label>
            <tab>ewave</tab>
            <resource>Ewave_ExtendedCart::config</resource>
            <group id="add_to_cart_confirmation_popup" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Add to cart confirmation popup</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Enables confirmation popup on add to cart action on storefront</comment>
                </field>
                <field id="promotion_block" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Promotion Block In Confirmation Popup</label>
                    <source_model>Ewave\ExtendedCart\Model\System\Config\Source\PromotionBlockInPopup</source_model>
                    <comment>You can promote related or up-sell items by displaying them on cart popup</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="promotion_block_products_count" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Number Of Products In Promotion Block</label>
                    <validate>validate-number validate-greater-than-zero validate-digits</validate>
                    <comment>Number of products to be shown in Related/Up-sell block on Confirmation Popup</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
            <group id="cart_page" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Cart Page</label>
                <field id="use_ajax_for_cart_update" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Recalculate Subtotals Without Page Reload</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Enables subtotals recalculation on the Cart page without page reload</comment>
                </field>
            </group>
        </section>
    </system>
</config>