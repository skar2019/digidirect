<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <ewave_pronto>
            <api_products>
                <products_get_uri>stock-master?call-type=full_enquiry</products_get_uri>
                <disabled_products_percent_skip_update>10</disabled_products_percent_skip_update>
            </api_products>
            <api_inventory>
                <inventory_get_uri><![CDATA[stock-master?call-type=change_enquiry&check-warehouse-change=Y&date-time-change-max]]></inventory_get_uri>
                <disabled_products_percent_skip_update>10</disabled_products_percent_skip_update>
                <diff_last_minutes>60</diff_last_minutes>
                <buffer_quantity_for_all_sources>0</buffer_quantity_for_all_sources>
                <buffer_action>0</buffer_action>
            </api_inventory>
            <api_order>
                <order_post_uri>sales?call-type=create_orders</order_post_uri>
                <order_get_uri>sales?call-type=get_order</order_get_uri>
            </api_order>
        </ewave_pronto>
    </default>
</config>
