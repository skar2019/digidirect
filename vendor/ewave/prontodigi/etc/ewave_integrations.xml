<?xml version="1.0" ?>
<integrations xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:noNamespaceSchemaLocation="urn:ewave:module:Ewave_AI:etc/ewave_integrations.xsd">
    <integration name="pronto_products_get">
        <integration_name>Pronto /product:GET</integration_name>
        <processor_class>Ewave\ProntoDigi\ProntoApi\Products\Get</processor_class>
        <can_admin_run>1</can_admin_run>
        <multiple_run>0</multiple_run>
    </integration>

    <integration name="pronto_inventory_get">
        <integration_name>Pronto /inventory:GET</integration_name>
        <processor_class>Ewave\ProntoDigi\ProntoApi\Inventory\Get</processor_class>
        <can_admin_run>1</can_admin_run>
        <multiple_run>0</multiple_run>
    </integration>

    <integration name="pronto_orders_post">
        <integration_name>Pronto /orders:POST</integration_name>
        <processor_class>Ewave\ProntoDigi\ProntoApi\Orders\Post</processor_class>
        <can_admin_run>1</can_admin_run>
        <multiple_run>1</multiple_run>
        <run_options>
            <option name="order">
                <front_name>Order Id</front_name>
                <front_type>input</front_type>
                <required>1</required>
            </option>
        </run_options>
    </integration>

    <integration name="pronto_orders_get">
        <integration_name>Pronto /orders:GET</integration_name>
        <processor_class>Ewave\ProntoDigi\ProntoApi\Orders\Get</processor_class>
        <can_admin_run>1</can_admin_run>
        <multiple_run>1</multiple_run>
        <run_options>
            <option name="order">
                <front_name>Order Id</front_name>
                <front_type>input</front_type>
                <required>1</required>
            </option>
        </run_options>
    </integration>
</integrations>