<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config" title="Configuration" sortOrder="20">
                            <resource id="Ewave_ExtendedShippingRates::config_extendedshippingrates" title="Shipping Rules Section (by Ewave)" sortOrder="90" />
                        </resource>
                    </resource>
                </resource>
                <resource id="Ewave_Utilities::ewave" sortOrder="100">
                    <resource id="Ewave_ExtendedShippingRates::extendedshippingrates" sortOrder="40" title="Ewave Shipping Suite">
                        <resource id="Ewave_ExtendedShippingRates::quote" sortOrder="40" title="Shipping Rules &amp; Restrictions (by Ewave)" />
                        <resource id="Ewave_ExtendedShippingRates::zone" sortOrder="50" title="Shipping Zones (by Ewave)" />
                        <resource id="Ewave_ExtendedShippingRates::carrier" sortOrder="45" title="Manage Carriers &amp; Shipping Methods (by Ewave)" />
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
