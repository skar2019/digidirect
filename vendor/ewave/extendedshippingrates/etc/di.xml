    <type name="Magento\Shipping\Model\Rate\Result">
        <plugin name="ewave_extendedshippingrates_update_rate_result"
                type="Ewave\ExtendedShippingRates\Model\Plugin\Shipping\Rate\Result\Append"
                sortOrder="10"
                disabled="false"/>
        <plugin name="ewave_extendedshippingrates_update_disabled_or_enabled_rates"
                type="Ewave\ExtendedShippingRates\Model\Plugin\Shipping\Rate\Result\GetAllRates"
                sortOrder="11"
                disabled="false"/>
    </type>
    <type name="Magento\Framework\App\Config">
        <plugin name="ewave_extendedshippingrates_add_shipping_methods"
                type="Ewave\ExtendedShippingRates\Model\Plugin\AddMethods"
                sortOrder="10"
                disabled="false"/>
    </type>
    <type name="Ewave\ExtendedShippingRates\Model\Rule\Action\RateFactory">
