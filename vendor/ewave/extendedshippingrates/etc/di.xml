                <item name="weight" xsi:type="string">Ewave\ExtendedShippingRates\Model\Rule\Action\Rate\PerUnitOfWeight</item>
                <item name="selected" xsi:type="string">Ewave\ExtendedShippingRates\Model\Rule\Action\Rate\PerSelectedItem</item>
            </argument>
        </arguments>
    </type>
