    <!-- Import -->
    <type name="Ewave\ExtendedShippingRates\Model\CsvUploader">
        <arguments>
            <argument name="baseTmpPath" xsi:type="string">tmp</argument>
            <argument name="basePath" xsi:type="string">tmp</argument>
            <argument name="allowedExtensions" xsi:type="array">
                <item name="csv" xsi:type="string">csv</item>
            </argument>
        </arguments>
    </type>
    <type name="Ewave\ExtendedShippingRates\Model\Rate\Import">
        <arguments>
            <argument name="defaultRateValues" xsi:type="array">
                <item name="active" xsi:type="string">1</item>
                <item name="priority" xsi:type="string">1</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\SalesRule\Model\Rule\Condition\Combine">
        <plugin name="Ewave_ExtendedShippingRates::MagentoSalesRuleModelRuleConditionCombine"
                type="Ewave\ExtendedShippingRates\Plugin\Magento\SalesRule\Model\Rule\Condition\Combine"/>
    </type>

    <type name="Ewave\ExtendedShippingRates\Model\Zone\Import">
        <arguments>
            <argument name="defaultZoneValues" xsi:type="array">
                <item name="is_active" xsi:type="string">0</item>
                <item name="attribute_set" xsi:type="string">1</item>
            </argument>
        </arguments>
    </type>

    <type name="Ewave\ExtendedShippingRates\Model\Zone">
        <arguments>
            <argument name="dataProcessors" xsi:type="array">
                <item name="country_id" xsi:type="object">Ewave\ExtendedShippingRates\Model\Zone\Processors\CountryIdDataProcessor</item>
                <item name="region_id" xsi:type="object">Ewave\ExtendedShippingRates\Model\Zone\Processors\RegionIdDataProcessor</item>
                <item name="postcode" xsi:type="object">Ewave\ExtendedShippingRates\Model\Zone\Processors\PostcodeDataProcessor</item>
            </argument>
            <argument name="defaultAggregator" xsi:type="array">
                <item name="aggregator" xsi:type="string">all</item>
                <item name="new_child" xsi:type="string"></item>
                <item name="type" xsi:type="string">Ewave\ExtendedShippingRates\Model\Zone\Condition\Combine</item>
                <item name="value" xsi:type="string">1</item>
            </argument>
        </arguments>
    </type>

    <type name="Ewave\ExtendedShippingRates\Model\Validator">
        <arguments>
            <argument name="actionMethodFields" xsi:type="array">
                <item name="overwrite_cost" xsi:type="array">
                    <item name="action" xsi:type="const">\Ewave\ExtendedShippingRates\Model\Rule::ACTION_OVERWRITE_COST</item>
                    <item name="fields" xsi:type="const">\Ewave\ExtendedShippingRates\Api\Data\RuleInterface::SHIPPING_METHODS</item>
                </item>
                <item name="disable_sm" xsi:type="array">
                    <item name="action" xsi:type="const">\Ewave\ExtendedShippingRates\Model\Rule::ACTION_DISABLE_SM</item>
                    <item name="fields" xsi:type="const">\Ewave\ExtendedShippingRates\Api\Data\RuleInterface::DISABLED_SHIPPING_METHODS</item>
                </item>
                <item name="use_alt_title" xsi:type="array">
                    <item name="action" xsi:type="const">\Ewave\ExtendedShippingRates\Model\Rule::ACTION_USE_ALT_TITLE</item>
                    <item name="fields" xsi:type="const">\Ewave\ExtendedShippingRates\Api\Data\RuleAlternativeTitleInterface::USED_ALT_TITLE_SHIPPING_METHODS</item>
                </item>
                <item name="use_alt_code" xsi:type="array">
                    <item name="action" xsi:type="const">\Ewave\ExtendedShippingRates\Model\Rule::ACTION_USE_ALT_CODE</item>
                    <item name="fields" xsi:type="const">\Ewave\ExtendedShippingRates\Api\Data\RuleAlternativeCodeInterface::USED_ALT_CODE_SHIPPING_METHODS</item>
                </item>
            </argument>
        </arguments>
