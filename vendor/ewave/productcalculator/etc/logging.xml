<?xml version="1.0"?>
<logging xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Logging:etc/logging.xsd">
    <groups>
        <group name="ewave_productcalcuator">
            <label translate="true">Product Calculator</label>
            <expected_models>
                <expected_model class="Ewave\ProductCalculator\Model\Calculator" />
            </expected_models>
            <events>
                <event controller_action="ewave_productcalculator_calculator_edit" action_alias="view" />
                <event controller_action="ewave_productcalculator_calculator_save" action_alias="save">
                    <skip_on_back>
                        <controller_action name="ewave_productcalculator_calculator_edit" />
                    </skip_on_back>
                </event>
                <event controller_action="ewave_productcalculator_calculator_delete" action_alias="delete" />
            </events>
        </group>
    </groups>
</logging>
