<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="after.body.start">
            <block class="Ewave\MyStoreWidget\Block\MyStore" name="header_mystore_widget" as="mystorewidget_header"
                   template="Ewave_MyStoreWidget::header/mystore.phtml" before="-">
                <arguments>
                    <argument name="storeNameFormat" xsi:type="string">%name (%state, %postcode)</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
