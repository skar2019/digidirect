<?php
/**
 * @var $block Ewave\MyStoreWidget\Block\MyStore
 * @var $helper Ewave\MyStoreWidget\Helper\Config
 * @var $urlHelper Ewave\AbstractEntity\Helper\Url
 */
$helper = $this->helper('Ewave\MyStoreWidget\Helper\Config');
$urlHelper = $this->helper('Ewave\AbstractEntity\Helper\Url');
$selectedStore = $block->getStoreName();
?>
<?php if ($helper->isGoogleAutoSuggestEnabled()): ?>
    <?php
    $availableCountries = $helper->getAvailableCountries();
    $countCountries = count($availableCountries);
    ?>
<?php endif; ?>
<div id="block-mystorebar" class="block-mystorebar<?php if ($selectedStore) :?> -selected<?php endif; ?>" data-mage-init='
    {
        "myStoreSwitcher": {
            "searchUrl": "<?php /* @escapeNotVerified */ echo $block->getSearchUrl(); ?>",
            <?php if ($helper->isGeoLocationEnabled()): ?>
               "isNeedKeepGeoLocation": <?php /* @escapeNotVerified */ echo (int)$helper->isNeedKeepGeolocation(); ?>,
               "isGeoLocationEnabled": <?php /* @escapeNotVerified */ echo (int)$helper->isGeoLocationEnabled(); ?>,
               "storesList": <?php /* @escapeNotVerified */ echo $block->getStores(); ?>,
            <?php endif; ?>
            <?php if ($helper->isGoogleAutoSuggestEnabled()): ?>
                "isGoogleAutoSuggestEnabled": <?php /* @escapeNotVerified */ echo (int)$helper->isGoogleAutoSuggestEnabled(); ?>,
                <?php if ($countCountries == 1): ?>
                    "singleCountryData":{"country": ["<?php /* @escapeNotVerified */ echo current($availableCountries); ?>"]},
                <?php endif; ?>
                <?php if ($countCountries > 1): ?>
                    "singleCountryData":{"country": <?php /* @escapeNotVerified */ echo json_encode($availableCountries); ?>},
                <?php endif; ?>
            <?php endif; ?>
            "autocompleteSettings": {
                "minLength": <?php echo (int)$helper->getSearchMinLength(); ?>
            },
            "isSelectedStore": <?php if ($selectedStore) :?>true<?php else: ?>false<?php endif; ?>
        }
    }
'>
    <form class="form" action="<?php /* @escapeNotVerified */ echo $block->getSaveUrl() ?>" method="post" id="mystore-form" data-mage-init='{"validation": {}}' data-hasrequired="<?php /* @escapeNotVerified */ echo __('* Required Fields') ?>">
        <input type="hidden" name="abstract_entity_id" id="abstract_entity_id" value="<?php if ($block->isStoreSelected()): ?><?php /* @escapeNotVerified */ echo $block->getStore()->getId() ?><?php endif; ?>" />
        <?php echo $block->getBlockHtml('formkey')?>
        <input type="hidden" name="<?php /* @escapeNotVerified */ echo \Magento\Framework\App\ActionInterface::PARAM_NAME_URL_ENCODED ?>" value="<?php /* @escapeNotVerified */ echo $this->helper('Magento\Framework\Url\Helper\Data')->getEncodedUrl() ?>"/>
        <div class="change-mode">
            <label class="message" for="<?= /* @escapeNotVerified */ $block->getMyStoreInputId() ?>">
                <?php if ($block->isStoreSelected() && !$block->isSearchTypeTextInput()): ?>
                    <?php /* @escapeNotVerified */ echo __('My %1:', $block->getStore()->getEntityName()); ?>
                <?php else: ?>
                    <?php /* @escapeNotVerified */ echo __('My Store:'); ?>
                <?php endif; ?>
            </label>
            <div class="input-group">
                <div class="control">
                    <div class="selection">
                        <?php if ($block->isStoreSelected() && $block->getStore()->getUrlKey() && !$block->isSearchTypeTextInput()): ?>
                            <a href="<?php /* @escapeNotVerified */ echo $urlHelper->getAbstractEntityUrl($block->getStore()->getId(), $block->getStore()->getStoreId()) ?>"><?php /* @escapeNotVerified */ echo $selectedStore ?></a>
                        <?php else: ?>
                            <?php /* @escapeNotVerified */ echo $selectedStore ?>
                        <?php endif; ?>
                    </div>
                </div>
                <button type="button" class="button action -change" data-action="change-store" title="<?php /* @escapeNotVerified */ echo __('Change') ?>">
                    <?php /* @escapeNotVerified */ echo __('Change') ?>
                </button>
            </div>
        </div>
        <div class="search-mode">
            <label class="message" for="<?= /* @escapeNotVerified */ $block->getMyStoreInputId() ?>>"><?php /* @escapeNotVerified */ echo __('Select Your Store'); ?>:</label>
            <div class="input-group">
                <div id="mystore-control" class="control">
                    <input type="text" name="store_name" id="<?= /* @escapeNotVerified */ $block->getMyStoreInputId() ?>" class="input-text" data-validate="{'required': true}" value="<?php /* @escapeNotVerified */ echo $selectedStore ?>"/>
                </div>
                <button type="submit" class="button action primary -submit" data-action="save-mystore" title="<?php /* @escapeNotVerified */ echo __('Submit') ?>">
                    <?php /* @escapeNotVerified */ echo __('Submit') ?>
                </button>
            </div>
        </div>
        <?php if ($helper->isGoogleAutoSuggestEnabled()): ?>
            <input type="hidden" name="find_store" id="mystore_find_store" value="0" />
            <input type="hidden" name="postcode" id="mystore_postal_code" value="" />
            <input type="hidden" name="city" id="mystore_locality" value="" />
            <input type="hidden" name="country" id="mystore_country" value="" />
        <?php endif; ?>
    </form>
</div>




