<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">

    <referenceBlock name="after.product.price.container">
        <block class="Ewave\ExtendedCatalogPriceRule\Block\ExtendedRule"
               name="ewave.extended.catalog.price.rule.list.view"
               template="Ewave_ExtendedCatalogPriceRule::product/view/list/display_message.phtml" >
            <arguments>
                <argument name="disable_product_types" xsi:type="array">
                    <item name="configurable" xsi:type="string">configurable</item>
                </argument>
            </arguments>
        </block>
    </referenceBlock>

</page>
