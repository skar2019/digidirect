<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Click and Collect Fields and Abstract Entity Attribute Fields relation to set up Store (matrix) -->
    <virtualType name="Ewave\CollectAbstractEntity\Block\Adminhtml\Form\Field\CollectFieldsMatrix"
                 type="Ewave\Utilities\Block\Adminhtml\Config\Form\Field\Relation">
        <arguments>
            <argument name="config" xsi:type="array">
                <item name="collect_field" xsi:type="array">
                    <item name="class" xsi:type="object">Ewave\CollectAbstractEntity\Block\Adminhtml\Config\Form\Field\Attribute\Renderer\CollectField</item>
                    <item name="label" xsi:type="string">Click and Collect Field</item>
                </item>
                <item name="abstract_entity_attribute_field" xsi:type="array">
                    <item name="class" xsi:type="object">Ewave\CollectAbstractEntity\Block\Adminhtml\Config\Form\Field\Attribute\Renderer\AbstractEntityAttr</item>
                    <item name="label" xsi:type="string">Abstract Entity Attribute</item>
                </item>
            </argument>
        </arguments>
    </virtualType>

    <!-- Click and Collect Field (matrix) -->
    <virtualType name="Ewave\CollectAbstractEntity\Block\Adminhtml\Config\Form\Field\Attribute\Renderer\CollectField"
                 type="Ewave\Utilities\Block\Adminhtml\Config\Form\Field\Attribute\Renderer\AbstractRenderer">
        <arguments>
            <argument name="attributeList" xsi:type="object">Ewave\CollectAbstractEntity\Model\System\Config\Source\CollectField</argument>
            <argument name="removeEmptyOption" xsi:type="boolean">true</argument>
        </arguments>
    </virtualType>

    <!-- Abstract Entity Attribute Field (matrix) -->
    <virtualType name="Ewave\CollectAbstractEntity\Block\Adminhtml\Config\Form\Field\Attribute\Renderer\AbstractEntityAttr"
                 type="Ewave\Utilities\Block\Adminhtml\Config\Form\Field\Attribute\Renderer\AbstractRenderer">
        <arguments>
            <argument name="attributeList" xsi:type="object">Ewave\CollectAbstractEntity\Model\System\Config\Source\AbstractEntityAttr</argument>
        </arguments>
    </virtualType>

</config>
