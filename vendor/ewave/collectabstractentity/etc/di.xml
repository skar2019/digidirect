<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- For AbstractEntity Model compatibility with CollectPlaceInterface-->
    <type name="Ewave\CollectAbstractEntity\Model\CollectPlaceRepository">
        <arguments>
            <argument name="abstractEntityRepository" xsi:type="object">AbstractEntityCollectRepository</argument>
        </arguments>
    </type>
    <virtualType name="AbstractEntityCollectRepository" type="Ewave\AbstractEntity\Model\AbstractEntityRepository">
        <arguments>
            <argument name="abstractEntityFactory"
                      xsi:type="object">AbstractEntityCollectFactory</argument>
            <argument name="abstractEntityCollectionFactory"
                      xsi:type="object">AbstractEntityCollectCollectionFactory</argument>
            <argument name="abstractEntityFlatCollectionFactory"
                      xsi:type="object">AbstractEntityCollectCollectionFlatFactory</argument>
        </arguments>
    </virtualType>
    <virtualType name="AbstractEntityCollectFactory" type="Ewave\AbstractEntity\Model\AbstractEntityFactory">
        <arguments>
            <argument name="instanceName"
                      xsi:type="string">Ewave\CollectAbstractEntity\Model\AbstractEntityCollectPlace</argument>
        </arguments>
    </virtualType>
    <virtualType name="AbstractEntityCollectCollectionFactory"
                 type="Ewave\AbstractEntity\Model\ResourceModel\AbstractEntity\CollectionFactory">
        <arguments>
            <argument name="instanceName"
                      xsi:type="string">Ewave\CollectAbstractEntity\Model\ResourceModel\AbstractEntity\Collect\Collection</argument>
        </arguments>
    </virtualType>
    <virtualType name="AbstractEntityCollectCollectionFlatFactory"
                 type="Ewave\AbstractEntity\Model\ResourceModel\AbstractEntity\FlatCollectionFactory">
        <arguments>
            <argument name="instanceName"
                      xsi:type="string">Ewave\CollectAbstractEntity\Model\ResourceModel\AbstractEntity\Collect\CollectionFlat</argument>
        </arguments>
    </virtualType>
</config>
