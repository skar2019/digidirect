<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="before.body.end">
            <block class="Ewave\CriteoOneTag\Block\Order" name="ewave.criteo.order"
                   template="Ewave_CriteoOneTag::onetag.phtml">
                <arguments>
                    <argument name="page_type" xsi:type="string">TransactionPage</argument>
                    <argument name="data_type" xsi:type="string">ProductTransactionProducts</argument>
                    <argument name="id_type" xsi:type="string">TransactionID</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
