<?xml version="1.0"?>
<logging xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Logging:etc/logging.xsd">
    <groups>
        <group name="attachments">
            <label translate="true">Manage Attachments</label>
            <expected_models>
                <expected_model class="Ewave\ProductAttachment\Model\Attachment" />
            </expected_models>
            <events>
                <event controller_action="ewave_productattachment_edit" action_alias="view" />
                <event controller_action="ewave_productattachment_save" action_alias="save">
                    <skip_on_back>
                        <controller_action name="ewave_productattachment_edit" />
                    </skip_on_back>
                </event>
                <event controller_action="ewave_productattachment_delete" action_alias="delete" />
            </events>
        </group>
    </groups>
</logging>