<?php
/** @var \Ewave\GiftCardImage\Block\Catalog\Product\View\Type\GiftCard\GiftCardImage $block */
/** @var \Ewave\GiftCardImage\Helper\Image $imageHelper */

use Ewave\GiftCardImage\Api\Data\GiftCardImageInterface;

$images = $block->getGiftcardImages();
$imageHelper = $this->helper('Ewave\GiftCardImage\Helper\Image');
$gallery = $block->getChildBlock('ewave.product.info.giftcard.images.gallery');
?>
<?php if ($images->count()): ?>
    <div class="fieldset">
        <div class="field required">
            <div class="label"><?php /* @escapeNotVerified */ echo __('Card Design'); ?></div>
            <div class="gift-images -loading" data-role="gift-images">
                <div data-role="loader" class="loading-mask">
                    <div class="loader">
                        <img src="<?php /* @escapeNotVerified */ echo $block->escapeUrl($this->helper('Ewave\Utilities\Helper\Animation')->getImage()); ?>"
                             alt="<?php /* @escapeNotVerified */ echo __('Loading...') ?>">
                        <?php if($_loaderText = $this->helper('Ewave\Utilities\Helper\Animation')->getText()): ?>
                            <p><?php /* @escapeNotVerified */ echo $_loaderText; ?></p>
                        <?php endif; ?>
                    </div>
                </div>
                <div class="gift-slider -inactive" data-role="gift-slider">
                    <?php foreach ($images as $image): ?>
                        <?php $imagePreview = $imageHelper->init($image, 'image') ?>
                        <span class="gift-item" data-role="gift-image" data-gift-image-id="<?php echo (int)$image->getId() ?>" >
                            <img class="image" src="<?php echo $block->escapeUrl($imagePreview->getUrl()) ?>"  alt="<?php echo $block->escapeHtml($image->getTitle()) ?>" />
                        </span>
                    <?php endforeach; ?>
                </div>
                <input class="input required-entry" type="text" name="<?php /* @escapeNotVerified */
                echo GiftCardImageInterface::PUBLIC_KEY; ?>"<?php if ($block->getPreConfiguredValue()): ?> value="<?php echo (int)$block->getPreConfiguredValue() ?>"<?php endif; ?>/>
            </div>
        </div>
    </div>

    <?php $selectedImage = $block->getPreConfiguredValue() ? (int)$block->getPreConfiguredValue() : 0 ?>

    <script type="text/x-magento-init">
        {
            "[data-role=gift-images]": {
                "giftCardGallery": {
                    "dataImages": <?php /* @escapeNotVerified */ echo $block->getJsonConfig() ?>,
                    "selectedImadeId": <?php /* @escapeNotVerified */ echo $selectedImage ?>,
                    "slickSettings": {
                        "slidesToShow": 5,
                        "infinite": false,
                        "prevArrow": "<button type=\"button\" class=\"slick-prev\">&lt;</button>",
                        "nextArrow": "<button type=\"button\" class=\"slick-next\">&gt;</button>"
                    }
                }
            }
        }
    </script>

<?php endif; ?>

