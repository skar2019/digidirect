<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Ewave\GiftCardImage\Api\GiftCardImageRepositoryInterface" type="Ewave\GiftCardImage\Model\GiftCardImageRepository" />
    <preference for="Ewave\GiftCardImage\Api\Data\GiftCardImageInterface" type="Ewave\GiftCardImage\Model\GiftCardImage" />

    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="ewave_giftcardimage_grid_data_source" xsi:type="string">Ewave\GiftCardImage\Model\ResourceModel\GiftCardImage\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
    <type name="Ewave\GiftCardImage\Model\ResourceModel\GiftCardImage\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">ewave_giftcard_image</argument>
            <argument name="eventPrefix" xsi:type="string">ewave_giftcardimage_grid_collection</argument>
            <argument name="eventObject" xsi:type="string">giftcard_image_collection</argument>
            <argument name="resourceModel" xsi:type="string">Ewave\GiftCardImage\Model\ResourceModel\GiftCardImage</argument>
        </arguments>
    </type>

    <virtualType name="giftcardMediaConfig" type="Ewave\Utilities\Model\Media\Config">
        <arguments>
            <argument name="data" xsi:type="array">
                <item name="baseMediaUrl" xsi:type="string">ewave/giftcatdimages</item>
                <item name="baseMediaPath" xsi:type="string">ewave/giftcatdimages</item>
                <item name="mediaUrl" xsi:type="string">ewave/giftcatdimages</item>
                <item name="mediaPath" xsi:type="string">ewave/giftcatdimages</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="giftcardImageModel" type="Ewave\Utilities\Model\Image">
        <arguments>
            <argument name="viewAssetImageFactory" xsi:type="object">giftcardAssetImageFactory</argument>
            <argument name="mediaConfig" xsi:type="object">giftcardMediaConfig</argument>
        </arguments>
    </virtualType>

    <virtualType name="giftcardImageFactory" type="Ewave\Utilities\Model\ImageFactory">
        <arguments>
            <argument name="instanceName" xsi:type="string">giftcardImageModel</argument>
        </arguments>
    </virtualType>

    <virtualType name="giftcardAssetImageFactory" type="Magento\Catalog\Model\View\Asset\ImageFactory">
        <arguments>
            <argument name="instanceName" xsi:type="string">giftcardAssetImageModel</argument>
        </arguments>
    </virtualType>
    <virtualType name="giftcardAssetImageModel" type="Magento\Catalog\Model\View\Asset\Image">
        <arguments>
            <argument name="mediaConfig" xsi:type="object">Ewave\GiftCardImage\Model\Media\Config</argument>
        </arguments>
    </virtualType>

    <type name="Ewave\GiftCardImage\Helper\Image">
        <arguments>
            <argument name="imageFactory" xsi:type="object">giftcardImageFactory</argument>
            <argument name="mediaConfig" xsi:type="object">giftcardMediaConfig</argument>
        </arguments>
    </type>

    <type name="Magento\GiftCard\Block\Sales\Order\Item\Renderer">
        <plugin name="Ewave_GiftCardImage::GiftCardBlockSalesOrderItemRenderer" type="Ewave\GiftCardImage\Plugin\Magento\GiftCard\Block\Sales\Order\Item\Renderer" />
    </type>
</config>
