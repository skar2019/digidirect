        <plugin name="Ewave_GiftCardImage::CheckoutBlockCartItemRenderer" type="Ewave\GiftCardImage\Plugin\Magento\Checkout\Block\Cart\Item\Renderer" />
    </type-->
    <type name="Magento\Checkout\CustomerData\DefaultItem">
        <plugin name="Ewave_GiftCardImage::CheckoutCustomerDataDefaultItem" type="Ewave\GiftCardImage\Plugin\Magento\Checkout\CustomerData\DefaultItem" />
    </type>
    <type name="Ewave\GiftCardImage\Plugin\Magento\Checkout\CustomerData\DefaultItem">
        <arguments>
            <argument name="giftcardImageType" xsi:type="string">ewave_giftcard_image_cart_mini</argument>
        </arguments>
    </type>
    <type name="Magento\GiftCard\Model\Catalog\Product\Type\Giftcard">
