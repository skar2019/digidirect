<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Checkout\Block\Cart\Item\Renderer">
        <plugin name="Ewave_GiftCardImage::CheckoutBlockCartItemRenderer" type="Ewave\GiftCardImage\Plugin\Magento\Checkout\Block\Cart\Item\Renderer" />
        <arguments>
            <argument name="imageBuilder" xsi:type="object">Ewave\GiftCardImage\Block\Catalog\Product\ImageBuilder</argument>
        </arguments>
    </type>
    <type name="Ewave\GiftCardImage\Block\Catalog\Product\ImageBuilder">
        <arguments>
            <argument name="giftcardImageType" xsi:type="string">ewave_giftcard_image_cart</argument>
        </arguments>
    </type>
