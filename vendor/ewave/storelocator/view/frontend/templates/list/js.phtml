<?php
/** @var \Ewave\Storelocator\Block\Wrapper $block */
$currentApi = $this->helper('Ewave\StoreLocator\Helper\Config')->getApi();
?>
<?php if ($currentApi === 'google') : ?>
    <?php
    $entities = $block->getEntities();
    $entityName = $block->getEntityName();
    $isInPopup = $block->getOpenInPopup();
    ?>
    <script type="text/x-magento-init">
        {
            ".store-locator": {
                "locator": {
                    <?php if ($entityName) : ?>"entityName": "<?= $block->escapeHtml($entityName) ?>",<?php endif; ?>
                    "defaultAddress": "<?php echo $block->escapeHtml($block->getDefaultCountry()) ?>",
                    "defaultLocations": <?php /* @escapeNotVerified */ echo $entities ?>,
                    "radius": {
                        "default": <?php echo (int)$block->getDefaultRadius() ?>,
                        "extensible": <?php /* @escapeNotVerified */ echo $block->getExtendRadius() ?>,
                        "metricType": "<?php /* @escapeNotVerified */ echo $block->getMetric() ?>"
                    },
                    "openInPopup": "<?php echo /* @noEscape */ $isInPopup; ?>",
                    "geoLocation": {
                        "enable": <?php /* @escapeNotVerified */ echo $block->isAskToUseGeolocationOnFirstVisit(); ?>
                    }
                }
            }
        }
    </script>
<?php endif; ?>
