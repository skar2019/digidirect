<?xml version="1.0"?>
<!--
/**
 * @package Ewave_StoreLocator
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Store/etc/config.xsd">
    <default>
        <ewave_storelocator_config>
            <list_settings>
                <metric>1</metric>
                <default_radius>25</default_radius>
                <radius_options>10,15,20,25,30,50,75,100</radius_options>
                <stores_on_locator_page>10</stores_on_locator_page>
                <max_stores_to_show>100</max_stores_to_show>
                <detail_click_action>redirect</detail_click_action>
                <group_search_results_by_parent_entity>1</group_search_results_by_parent_entity>
            </list_settings>
            <general>
                <api>google</api>
            </general>
        </ewave_storelocator_config>
    </default>
</config>