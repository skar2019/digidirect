<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Magento\Framework\View\Result\Page" type="Ewave\Utilities\Preference\Magento\Framework\View\Result\Page"/>
    <preference for="Magento\Sitemap\Model\Sitemap" type="Ewave\Utilities\Model\Sitemap"/>
    <preference for="Magento\Framework\Mail\Template\TransportBuilder" type="Ewave\Utilities\Preference\Magento\Framework\Mail\Template\TransportBuilder"/>
    <preference for="Magento\Catalog\Model\Attribute\Config\Reader" type="Ewave\Utilities\Model\Catalog\Attribute\Config\Reader"/>
    <preference for="Ewave\Utilities\Model\Media\ConfigInterface" type="Ewave\Utilities\Model\Media\Config"/>

    <type name="Magento\Config\Model\Config\Backend\Image">
        <plugin name="bafore-save-image-loading-animation" type="Ewave\Utilities\Plugin\Magento\Config\Model\Config\Backend\Image"/>
    </type>
    <type name="Magento\Catalog\Helper\Image">
        <plugin name="Ewave_Utilities::CatalogHelperImage" type="Ewave\Utilities\Plugin\Catalog\Helper\Image" sortOrder="1"/>
    </type>
    <type name="Magento\ConfigurableProduct\Block\Product\View\Type\Configurable">
        <plugin name="ewave_utilities_configurable_product_block_type_configurable"
                type="Ewave\Utilities\Plugin\ConfigurableProduct\Block\Product\View\Type\Configurable" sortOrder="1"/>
    </type>
    <type name="Magento\CatalogInventory\Model\StockStateProvider">
        <plugin name="ewave_utilities_stock_state_provider_after_check_quote_item_qty"
                type="Ewave\Utilities\Plugin\Magento\CatalogInventory\Model\StockStateProvider" sortOrder="1"/>
    </type>

    <type name="Ewave\Utilities\Model\Config\Reader">
        <arguments>
            <argument name="fileResolver" xsi:type="object">Ewave\Utilities\Model\Config\FileResolver</argument>
        </arguments>
    </type>
    <type name="Magento\Framework\View\Element\Message\Renderer\RenderersPool">
        <arguments>
            <argument name="renderers" xsi:type="array">
                <item name="escape_renderer" xsi:type="object">Magento\Framework\View\Element\Message\Renderer\EscapeRenderer</item>
                <item name="block_renderer" xsi:type="object">Magento\Framework\View\Element\Message\Renderer\BlockRenderer</item>
                <item name="extended_renderer" xsi:type="object">Ewave\Utilities\Block\View\Element\Message\Renderer\ExtendedRenderer</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Framework\Config\Dom\UrnResolver">
        <plugin name="Ewave_Utilities::SchemaOverride" type="Ewave\Utilities\Plugin\Magento\Framework\Config\Dom\UrnResolver" sortOrder="1"/>
    </type>
    <type name="Ewave\Utilities\Plugin\Magento\Framework\Config\Dom\UrnResolver">
        <arguments>
            <argument name="overwrittenSchemas" xsi:type="array">
                <item name="urn:magento:framework:Config/etc/view.xsd" xsi:type="string">urn:ewave:module:Ewave_Utilities:etc/view.xsd</item>
            </argument>
        </arguments>
    </type>
</config>
