<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Ewave\Banner\Model\Attributes\Config">
        <arguments>
            <argument name="config" xsi:type="array">
                <item name="types" xsi:type="array">
                    <item name="images" xsi:type="object">Ewave\Banner\Model\Attributes\Image\Proxy</item>
                    <item name="target_id" xsi:type="object">Ewave\Banner\Model\Attributes\TargetLink\Proxy</item>
                    <item name="navigation_title" xsi:type="object">Ewave\Banner\Model\Attributes\NavigationTitle\Proxy</item>
                    <item name="video" xsi:type="object">Ewave\Banner\Model\Attributes\Video\Proxy</item>
                    <item name="navigation_image" xsi:type="object">Ewave\Banner\Model\Attributes\NavigationImage\Proxy</item>
                </item>
            </argument>
        </arguments>
    </type>
    <type name="Ewave\Banner\Model\Attributes">
        <arguments>
            <argument name="data" xsi:type="array">
                <item name="banner_attributes" xsi:type="array">
                    <item name="images" xsi:type="array">
                        <item name="custom" xsi:type="boolean">true</item>
                    </item>
                    <item name="navigation_title" xsi:type="array">
                        <item name="custom" xsi:type="boolean">true</item>
                    </item>
                    <item name="target_id" xsi:type="array">
                        <item name="custom" xsi:type="boolean">true</item>
                    </item>
                    <item name="target_type" xsi:type="array">
                        <item name="custom" xsi:type="boolean">false</item>
                    </item>
                    <item name="alt" xsi:type="array">
                        <item name="custom" xsi:type="boolean">false</item>
                    </item>
                    <item name="video" xsi:type="array">
                        <item name="custom" xsi:type="boolean">true</item>
                    </item>
                    <item name="navigation_title_type" xsi:type="array">
                        <item name="custom" xsi:type="boolean">false</item>
                    </item>
                    <item name="navigation_image" xsi:type="array">
                        <item name="custom" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </arguments>
        <plugin name="add-video-to-custom-attributes" type="Ewave\Banner\Plugin\Model\Attributes" />
    </type>
    <type name="Ewave\Banner\Model\Attributes\TargetType\Config">
        <arguments>
            <argument name="config" xsi:type="array">
                <item name="types" xsi:type="array">
                    <item name="product" xsi:type="array">
                        <item name="id" xsi:type="string">product</item>
                        <item name="label" xsi:type="string">Product</item>
                        <item name="object" xsi:type="object">Ewave\Banner\Model\Attributes\TargetType\Product</item>
                        <item name="form_map_name" xsi:type="string">product_name</item>
                    </item>
                    <item name="category" xsi:type="array">
                        <item name="id" xsi:type="string">category</item>
                        <item name="label" xsi:type="string">Category</item>
                        <item name="object" xsi:type="object">Ewave\Banner\Model\Attributes\TargetType\Category</item>
                        <item name="form_map_name" xsi:type="string">category_id</item>
                    </item>
                    <item name="custom_link" xsi:type="array">
                        <item name="id" xsi:type="string">custom_link</item>
                        <item name="label" xsi:type="string">Custom Link</item>
                        <item name="object" xsi:type="object">Ewave\Banner\Model\Attributes\TargetType\Custom</item>
                        <item name="form_map_name" xsi:type="string">custom_link</item>
                    </item>
                </item>
            </argument>
        </arguments>
    </type>
    <type name="Ewave\Banner\Model\Image\Uploader">
        <arguments>
            <argument name="data" xsi:type="array">
                <item name="allowed_video_types" xsi:type="array">
                    <item name="mp4" xsi:type="string">mp4</item>
                </item>
            </argument>
        </arguments>
    </type>
    <type name="Ewave\Banner\Model\Attributes\Video">
        <arguments>
            <argument name="data" xsi:type="array">
                <item name="url_fields" xsi:type="array">
                    <item name="preview_image" xsi:type="string">preview_image</item>
                    <item name="video" xsi:type="string">video</item>
                </item>
            </argument>
        </arguments>
    </type>
    <type name="Ewave\Banner\Plugin\Model\Attributes">
        <arguments>
            <argument name="config" xsi:type="array">
                <item name="extension_attributes" xsi:type="array">
                    <item name="video" xsi:type="object">Ewave\Banner\Model\Attributes\ExtensionAttributes\Video\Proxy</item>
                </item>
            </argument>
        </arguments>
    </type>
    <type name="Ewave\Banner\Model\Attributes\ExtensionAttributes\Video">
        <arguments>
            <argument name="config" xsi:type="array">
                <item name="use_video_as_a_preview" xsi:type="string"/>
                <item name="allow_video_popup" xsi:type="string"/>
                <item name="play_video_in_a_loop" xsi:type="string"/>
                <item name="play_video_after" xsi:type="string"/>
                <item name="play_video_automatically_for_mobile" xsi:type="string"/>
                <item name="play_video_automatically_for_desktop" xsi:type="string"/>
                <item name="video_title" xsi:type="string"/>
                <item name="preview_image" xsi:type="string"/>
                <item name="video" xsi:type="string">path</item>
                <item name="video_id" xsi:type="string">value_id</item>
                <item name="video_role_ids" xsi:type="string">video_roles</item>
                <item name="video_folder" xsi:type="string"/>
                <item name="video_size" xsi:type="string"></item>
            </argument>
        </arguments>
    </type>



    <!-- PREFERENCES: TODO: do rewrite for all classes that are used in plugins -->
    <type name="Ewave\Banner\Plugin\Magento\Widget\Model\Widget\Instance">
        <arguments>
            <!-- MUST BE CHANGED IN CE -->
            <argument name="requiredInstance" xsi:type="string">Magento\Banner\Block\Widget\Banner</argument>
            <!-- EOF MUST BE CHANGED IN CE-->
        </arguments>
    </type>

    <!-- extends inheritance class \Ewave\Banner\Inheritance\Magento\Banner\Model\Banner-->
    <preference for="Magento\Banner\Model\Banner" type="Ewave\Banner\Preference\Magento\Banner\Model\BannerModel" />

        <!-- DONE -->
    <preference for="Magento\Banner\Model\Banner\Data" type="Ewave\Banner\Preference\Magento\Banner\Model\Banner\Data" />
        <!-- EOF DONE -->

        <!-- DONE -->
    <preference for="Magento\Banner\Block\Widget\Banner" type="Ewave\Banner\Block\Widget\Banner" />
        <!-- EOF DONE -->


    <type name="Magento\Banner\Model\ResourceModel\Banner">
        <plugin name="modify-banner-content" type="Ewave\Banner\Plugin\Magento\Banner\Model\ResourceModel\Banner"/>
    </type>
        <!-- do not need to do preference for this class -->
    <type name="\Magento\Widget\Model\Widget\Instance">
        <plugin name="validate-speed-rotation" type="Ewave\Banner\Plugin\Magento\Widget\Model\Widget\Instance"/>
    </type>
        <!-- eof class not required -->
    <!-- EOF PREFERENCES-->

    <type name="Ewave\Banner\Model\Upload\ImageProcessor">
        <arguments>
            <argument name="imageUploader" xsi:type="object">Ewave\Banner\BannerImageUpload</argument>
        </arguments>
    </type>
    <virtualType name="Ewave\Banner\BannerImageUpload" type="Ewave\Banner\Model\Upload\ImageUploader">
        <arguments>
            <argument name="baseTmpPath" xsi:type="string">ewave_banner/tmp/image</argument>
            <argument name="basePath" xsi:type="string">ewave_banner/image</argument>
            <argument name="allowedExtensions" xsi:type="array">
                <item name="jpg" xsi:type="string">jpg</item>
                <item name="jpeg" xsi:type="string">jpeg</item>
                <item name="gif" xsi:type="string">gif</item>
                <item name="png" xsi:type="string">png</item>
            </argument>
        </arguments>
    </virtualType>
</config>