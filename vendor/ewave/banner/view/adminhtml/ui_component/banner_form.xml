<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="component" xsi:type="string">Ewave_Banner/js/banner-form</item>
        </item>
    </argument>
    <fieldset name="properties" sortOrder="10">
        <field name="navigation_title_type" formElement="select">
            <settings>
                <switcherConfig>
                    <rules>
                        <rule name="0">
                            <value>1</value>
                            <actions>
                                <action name="0">
                                    <target>banner_form.banner_form.properties.navigation_title</target>
                                    <callback>show</callback>
                                </action>
                                <action name="1">
                                    <target>banner_form.banner_form.properties.navigation_image</target>
                                    <callback>hide</callback>
                                </action>
                            </actions>
                        </rule>
                        <rule name="1">
                            <value>2</value>
                            <actions>
                                <action name="0">
                                    <target>banner_form.banner_form.properties.navigation_image</target>
                                    <callback>show</callback>
                                </action>
                                <action name="1">
                                    <target>banner_form.banner_form.properties.navigation_title</target>
                                    <callback>hide</callback>
                                </action>
                            </actions>
                        </rule>
                    </rules>
                    <enabled>true</enabled>
                </switcherConfig>
                <dataType>text</dataType>
                <label translate="true">Navigation Type</label>
                <scopeLabel>[GLOBAL]</scopeLabel>
                <visible>true</visible>
                <dataScope>navigation_title_type</dataScope>
                <imports>
                    <link name="disabled">${ $.provider }:data.readonly</link>
                </imports>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Ewave\Banner\Source\NavigationTypes"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="navigation_title">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">wysiwyg</item>
                    <item name="label" xsi:type="string">Navigation Title</item>
                    <item name="template" xsi:type="string">ui/form/field</item>
                    <item name="wysiwyg" xsi:type="boolean">true</item>
                    <item name="dataScope" xsi:type="string">navigation_title</item>
                    <item name="rows" xsi:type="number">8</item>
                    <item name="sortOrder" xsi:type="number">20</item>
                </item>
            </argument>
        </field>

        <field name="navigation_image">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">string</item>
                    <item name="source" xsi:type="string">image</item>
                    <item name="label" xsi:type="string" translate="true">Navigation Image</item>
                    <item name="visible" xsi:type="boolean">true</item>
                    <item name="formElement" xsi:type="string">fileUploader</item>
                    <item name="componentType" xsi:type="string">fileUploader</item>
                    <item name="elementTmpl" xsi:type="string">ui/form/element/uploader/uploader</item>
                    <item name="required" xsi:type="boolean">true</item>
                    <item name="sortOrder" xsi:type="number">30</item>
                    <item name="uploaderConfig" xsi:type="array">
                        <item name="url" xsi:type="url" path="ewave_banner/banner/upload"/>
                    </item>
                </item>
            </argument>
        </field>
    </fieldset>
    <fieldset name="link_options" sortOrder="15">
        <settings>
            <opened>true</opened>
            <collapsible>true</collapsible>
            <label translate="true">Link Options</label>
        </settings>
        <field name="target_type" formElement="select" component="Ewave_Banner/js/select-target-type">
            <settings>
                <switcherConfig>
                    <rules>
                        <rule name="0">
                            <value>product</value>
                            <actions>
                                <action name="0">
                                    <target>banner_form.banner_form.link_options.product_name</target>
                                    <callback>show</callback>
                                </action>
                                <action name="1">
                                    <target>banner_form.banner_form.link_options.category_id</target>
                                    <callback>hide</callback>
                                </action>
                                <action name="2">
                                    <target>banner_form.banner_form.link_options.custom_link</target>
                                    <callback>hide</callback>
                                </action>
                            </actions>
                        </rule>
                        <rule name="1">
                            <value>category</value>
                            <actions>
                                <action name="0">
                                    <target>banner_form.banner_form.link_options.product_name</target>
                                    <callback>hide</callback>
                                </action>
                                <action name="1">
                                    <target>banner_form.banner_form.link_options.category_id</target>
                                    <callback>show</callback>
                                </action>
                                <action name="2">
                                    <target>banner_form.banner_form.link_options.custom_link</target>
                                    <callback>hide</callback>
                                </action>
                            </actions>
                        </rule>
                        <rule name="2">
                            <value>custom_link</value>
                            <actions>
                                <action name="0">
                                    <target>banner_form.banner_form.link_options.product_name</target>
                                    <callback>hide</callback>
                                </action>
                                <action name="1">
                                    <target>banner_form.banner_form.link_options.category_id</target>
                                    <callback>hide</callback>
                                </action>
                                <action name="2">
                                    <target>banner_form.banner_form.link_options.custom_link</target>
                                    <callback>show</callback>
                                </action>
                            </actions>
                        </rule>
                    </rules>
                    <enabled>true</enabled>
                </switcherConfig>
                <dataType>text</dataType>
                <label translate="true">Select Link Type</label>
                <scopeLabel>[GLOBAL]</scopeLabel>
                <visible>true</visible>
                <dataScope>target_type</dataScope>
                <imports>
                    <link name="disabled">${ $.provider }:data.readonly</link>
                </imports>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Ewave\Banner\Model\Attributes\TargetType\Config"/>
                    </settings>
                </select>
            </formElements>
        </field>

        <field name="product_name" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Select Product</label>
                <scopeLabel>[GLOBAL]</scopeLabel>
                <visible>false</visible>
                <dataScope>product_name</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>

        <field name="product_id" formElement="hidden">
            <settings>
                <dataType>text</dataType>
                <dataScope>product_id</dataScope>
            </settings>
        </field>

        <field name="category_id" formElement="select">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Select Category</label>
                <scopeLabel>[GLOBAL]</scopeLabel>
                <visible>true</visible>
                <dataScope>category_id</dataScope>
                <imports>
                    <link name="disabled">${ $.provider }:data.readonly</link>
                </imports>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Ewave\Banner\Source\Categories"/>
                    </settings>
                </select>
            </formElements>
        </field>

        <field name="custom_link" formElement="input">
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Custom Link</label>
                <scopeLabel>[GLOBAL]</scopeLabel>
                <visible>false</visible>
                <dataScope>custom_link</dataScope>
                <notice>'The field allow fully qualified URLs that end with '/' (slash) e.g. http://example.com/'</notice>
                <imports>
                    <link name="disabled">${ $.provider }:data.readonly</link>
                </imports>
            </settings>
        </field>

        <container template="ui/form/components/complex">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string"/>
                </item>
            </argument>
            <button>
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="buttonClasses" xsi:type="string">js-product-chooser-button</item>
                        <item name="actions" xsi:type="array">
                            <item name="0" xsi:type="array">
                                <item name="targetName" xsi:type="string">banner_form.banner_form.link_options.product_chooser_modal</item>
                                <item name="actionName" xsi:type="string">openModal</item>
                            </item>
                        </item>
                    </item>
                </argument>
                <settings>
                    <title translate="true">Choose Product...</title>
                </settings>
            </button>
        </container>
        <modal name="product_chooser_modal" component="Ewave_Banner/js/product-chooser">
            <settings>
                <options>
                    <option name="title" xsi:type="string">Select Product...</option>
                </options>
            </settings>
            <htmlContent name="html_content">
                <block name="product_chooser_banner" class="Ewave\Banner\Block\Adminhtml\Banner\Edit\Tab\ProductChooser"/>
            </htmlContent>
        </modal>
    </fieldset>
    <fieldset name="images_and_videos" sortOrder="20">
        <settings>
            <opened>true</opened>
            <collapsible>true</collapsible>
            <label translate="true">Images and Videos</label>
        </settings>
        <htmlContent name="html_content" template="Ewave_Banner/content">
            <block name="banner_images" class="Ewave\Banner\Block\Adminhtml\Banner\Edit\Tab\Images"/>
        </htmlContent>
        <field name="alt" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Alt text</label>
                <scopeLabel>[GLOBAL]</scopeLabel>
                <visible>true</visible>
                <dataScope>alt</dataScope>
                <imports>
                    <link name="disabled">${ $.provider }:data.readonly</link>
                </imports>
            </settings>
        </field>
    </fieldset>
</form>
