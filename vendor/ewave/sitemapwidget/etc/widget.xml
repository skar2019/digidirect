<?xml version="1.0" encoding="UTF-8"?>
<widgets xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Widget:etc/widget.xsd">
    <widget id="ewave_sitemap_widget" class="Ewave\SitemapWidget\Block\Widget\Sitemap">
        <label>Sitemap Widget</label>
        <description>List of CMS Pages, Categoryes and Products</description>
        <parameters>
            <parameter xsi:type="select" name="widget_template" visible="true" sort_order="10"
                       source_model="Ewave\SitemapWidget\Model\Widget\Options\Template" required="true">
                <label translate="true">Select Template</label>
            </parameter>
            <parameter xsi:type="text" name="custom_template" visible="true" sort_order="20" required="true">
                <label translate="true">Custom Template Name</label>
                <description>Ewave_SitemapWidget::widget/custom/{{custom_template}}.phtml</description>
                <depends>
                    <parameter name="widget_template" value="custom"/>
                </depends>
            </parameter>
            <parameter name="show_products" sort_order="30" xsi:type="select" visible="true"
                       source_model="Magento\Config\Model\Config\Source\Yesno">
                <label translate="true">Show Products</label>
            </parameter>
            <parameter name="show_categories" sort_order="40" xsi:type="select" visible="true">
                <label translate="true">Show Categories</label>
                <options>
                    <option name="no" value="0">
                        <label translate="true">No</label>
                    </option>
                    <option name="yes" value="1" selected="true">
                        <label translate="true">Yes</label>
                    </option>
                </options>
            </parameter>
            <parameter name="show_pages" sort_order="50" xsi:type="multiselect" visible="true"
                       source_model="Magento\Cms\Model\Config\Source\Page">
                <label translate="true">Show CMS Pages</label>
                <description>List of static website pages to include in sitemap</description>
            </parameter>
        </parameters>
    </widget>
</widgets>
