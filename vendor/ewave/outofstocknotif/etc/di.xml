<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\ProductAlert\Model\Observer">
        <plugin name="Ewave_OutOfStockNotif::guestStockNotification" type="Ewave\OutOfStockNotif\Plugin\ProductAlert\Model\Observer" />
    </type>
    <type name="Magento\ProductAlert\Model\ResourceModel\Stock\Collection">
        <plugin name="Ewave_OutOfStockNotif::removeGuestsFromCollection" type="Ewave\OutOfStockNotif\Plugin\ProductAlert\Model\ResourceModel\Stock\Collection" />
    </type>
    <virtualType name="Ewave\OutOfStockNotif\Model\EmailFactory" type="Magento\ProductAlert\Model\EmailFactory">
        <arguments>
            <argument name="instanceName" xsi:type="string">Ewave\OutOfStockNotif\Model\Email</argument>
        </arguments>
    </virtualType>
    <type name="Ewave\OutOfStockNotif\Model\Observer">
        <arguments>
            <argument name="emailFactory" xsi:type="object">Ewave\OutOfStockNotif\Model\EmailFactory</argument>
        </arguments>
    </type>

    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="ewave_outofstock_grid_data_source" xsi:type="string">Ewave\OutOfStockNotif\Model\ResourceModel\Stock\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
    <type name="Ewave\OutOfStockNotif\Model\ResourceModel\Stock\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">product_alert_stock</argument>
            <argument name="eventPrefix" xsi:type="string">ewave_outofstock_grid_collection</argument>
            <argument name="eventObject" xsi:type="string">ewave_outofstock_grid_collection</argument>
            <argument name="resourceModel" xsi:type="string">Magento\ProductAlert\Model\ResourceModel\Stock</argument>
        </arguments>
    </type>
</config>
