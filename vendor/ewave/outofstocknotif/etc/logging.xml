<?xml version="1.0"?>
<logging xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Logging:etc/logging.xsd">
    <groups>
        <group name="ewave_outofstock">
            <label translate="true">Ewave Out Of Stock Notification</label>
            <expected_models>
                <expected_model class="Magento\ProductAlert\Model\Stock" />
            </expected_models>
            <events>
                <event controller_action="ewave_outofstock_index_delete" action_alias="delete" />
                <event controller_action="ewave_outofstock_index_massDelete" action_alias="massDelete" />
            </events>
        </group>
    </groups>
</logging>