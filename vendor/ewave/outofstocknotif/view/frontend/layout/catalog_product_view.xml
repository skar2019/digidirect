<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="productalert.stock" remove="true"/>
        <referenceContainer name="alert.urls">
            <block class="Ewave\OutOfStockNotif\Block\Product\View\Stock" name="productalert.stock.ewave" as="productalert_stock_ewave" template="Magento_ProductAlert::product/view.phtml">
                <arguments>
                    <argument name="guest_template" xsi:type="string">Ewave_OutOfStockNotif::product/view.phtml</argument>
                    <argument name="default_template" xsi:type="string">Magento_ProductAlert::product/view.phtml</argument>
                    <argument name="html_class" xsi:type="string">stock ewave-out-of-stock-notification</argument>
                    <argument translate="true" name="button_label" xsi:type="string">Notify me when in stock</argument>
                    <argument name="modal_options" xsi:type="array">
                        <item name="type" xsi:type="string">popup</item>
                        <item name="title" xsi:type="string" translate="true">Notify Me</item>
                        <item name="modalClass" xsi:type="string">outofstock-modal</item>
                        <item name="buttons" xsi:type="array"/>
                    </argument>
                </arguments>
                <action method="setHtmlClass">
                    <argument name="value" xsi:type="string">stock</argument>
                </action>
                <action method="setSignupLabel">
                    <argument translate="true" name="value" xsi:type="string">Email Address</argument>
                </action>
            </block>
        </referenceContainer>

        <referenceContainer name="product.info.main">
            <block class="Magento\Framework\View\Element\Template" name="outstock.button" template="Ewave_OutOfStockNotif::product/button.phtml" after="product.info">
                <arguments>
                    <argument translate="true" name="button_label" xsi:type="string">Notify me when in stock</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
