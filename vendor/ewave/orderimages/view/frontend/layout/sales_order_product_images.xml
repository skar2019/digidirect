<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="order.items.table.head.start">
            <block class="Magento\Framework\View\Element\Template" name="order.items.table.head.image" template="Ewave_OrderImages::order/th-image.phtml">
                <arguments>
                    <argument name="image_type" xsi:type="string">order_product_thumbnail_image</argument>
                </arguments>
            </block>
        </referenceContainer>

        <referenceBlock name="order.items.table.body.start">
            <arguments>
                <argument name="cell_count" xsi:type="number">1</argument>
            </arguments>
            <block class="Ewave\OrderImages\Block\Order\Items\Image" name="item_image" template="Ewave_OrderImages::order/image.phtml">
                <arguments>
                    <argument name="image_type" xsi:type="string">order_product_thumbnail_image</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
