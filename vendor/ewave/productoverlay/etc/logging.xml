<?xml version="1.0" encoding="UTF-8"?>
<logging xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Logging:etc/logging.xsd">
    <groups>
        <group name="ewave_productoverlay_overlays">
            <label translate="true">Ewave Product Overlay</label>
            <expected_models>
                <expected_model class="Ewave\ProductOverlay\Model\Overlays" />
            </expected_models>
            <events>
                <event controller_action="ewave_productoverlay_overlays_edit" action_alias="view" />
                <event controller_action="ewave_productoverlay_overlays_save" action_alias="save">
                    <skip_on_back>
                        <controller_action name="ewave_productoverlay_overlays_edit" />
                    </skip_on_back>
                </event>
                <event controller_action="ewave_productoverlay_overlays_delete" action_alias="delete" />
            </events>
        </group>
    </groups>
</logging>