<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Catalog\Block\Product\Image">
        <plugin name="Ewave_ProductOverlay::AddOverlay"
                type="Ewave\ProductOverlay\Plugin\Catalog\Product\Overlay"/>
    </type>
    <type name="Magento\Catalog\Block\Product\View\Gallery">
        <plugin name="Ewave_ProductOverlay::AddOverlay"
                type="Ewave\ProductOverlay\Plugin\Catalog\Product\View\Overlay"/>
    </type>
    <type name="Magento\Catalog\Block\Product\ImageBuilder">
        <plugin name="Ewave_ProductOverlay::AddProductToData"
                type="Ewave\ProductOverlay\Plugin\Catalog\Product\ImageBuilder"/>
    </type>
    <preference for="Magento\Swatches\Block\Product\Renderer\Configurable" type="Ewave\ProductOverlay\Preference\Magento\Swatches\Block\Product\Renderer\Configurable" />
    <preference for="Magento\Swatches\Block\Product\Renderer\Listing\Configurable" type="Ewave\ProductOverlay\Preference\Magento\Swatches\Block\Product\Renderer\Listing\Configurable" />
</config>
