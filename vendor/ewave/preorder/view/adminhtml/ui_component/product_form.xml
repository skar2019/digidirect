<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <modal name="advanced_inventory_modal">
        <fieldset name="stock_data">
            <container name="container_ewave_preorder_note">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="formElement" xsi:type="string">container</item>
                        <item name="component" xsi:type="string">Magento_Ui/js/form/components/group</item>
                        <item name="label" xsi:type="string" translate="true">Ewave Pre Order Config</item>
                        <item name="dataScope" xsi:type="string"/>
                        <item name="sortOrder" xsi:type="number">810</item>
                        <item name="scopeLabel" xsi:type="string">[STORE VIEW]</item>
                        <item name="imports" xsi:type="array">
                            <item name="visible" xsi:type="string">${$.provider}:data.product.stock_data.backorders:111</item>
                        </item>
                    </item>
                </argument>
                <field name="ewave_preorder_note">
                    <argument name="data" xsi:type="array">
                        <item name="config" xsi:type="array">
                            <item name="label" xsi:type="string" translate="true">Pre-Order Note</item>
                            <item name="formElement" xsi:type="string">input</item>
                            <item name="scopeLabel" xsi:type="string">[STORE VIEW]</item>
                            <item name="dataScope" xsi:type="string">ewave_preorder_note</item>
                            <item name="notice" xsi:type="string" translate="true">Use #availability_date# tag in case, when "Product Availability Date" should be mentioned on storefront in text message.</item>
                        </item>
                    </argument>
                </field>
            </container>
            <container name="container_ewave_preorder_cart_label">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="formElement" xsi:type="string">container</item>
                        <item name="component" xsi:type="string">Magento_Ui/js/form/components/group</item>
                        <item name="label" xsi:type="string" translate="true">Ewave Pre Order Config</item>
                        <item name="dataScope" xsi:type="string"/>
                        <item name="sortOrder" xsi:type="number">810</item>
                        <item name="scopeLabel" xsi:type="string">[STORE VIEW]</item>
                        <item name="imports" xsi:type="array">
                            <item name="visible" xsi:type="string">${$.provider}:data.product.stock_data.backorders:111</item>
                        </item>
                    </item>
                </argument>
                <field name="ewave_preorder_cart_label">
                    <argument name="data" xsi:type="array">
                        <item name="config" xsi:type="array">
                            <item name="label" xsi:type="string" translate="true">Pre-Order Cart Button</item>
                            <item name="formElement" xsi:type="string">input</item>
                            <item name="scopeLabel" xsi:type="string">[STORE VIEW]</item>
                            <item name="dataScope" xsi:type="string">ewave_preorder_cart_label</item>
                        </item>
                    </argument>
                </field>
            </container>
            <container name="container_ewave_product_availability_date">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="formElement" xsi:type="string">container</item>
                        <item name="component" xsi:type="string">Magento_Ui/js/form/components/group</item>
                        <item name="label" xsi:type="string" translate="true">Ewave Pre Order Config</item>
                        <item name="dataScope" xsi:type="string" />
                        <item name="sortOrder" xsi:type="number">820</item>
                        <item name="scopeLabel" xsi:type="string">[STORE VIEW]</item>
                    </item>
                </argument>
                <field name="ewave_product_availability_date">
                    <argument name="data" xsi:type="array">
                        <item name="config" xsi:type="array">
                            <item name="label" xsi:type="string" translate="true">Product Availability Date</item>
                            <item name="formElement" xsi:type="string">date</item>
                            <item name="scopeLabel" xsi:type="string">[STORE VIEW]</item>
                            <item name="dataScope" xsi:type="string">ewave_product_availability_date</item>
                            <item name="notice" xsi:type="string" translate="true">If date is set, it will be added as a dynamic parameter into "Pre-Order Note" text message.</item>
                            <item name="options" xsi:type="array">
                                <item name="minDate" xsi:type="string">0</item>
                            </item>
                        </item>
                    </argument>
                </field>
            </container>
            <container name="container_ewave_preorder_switcher">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="component" xsi:type="string">Ewave_PreOrder/js/switcher</item>
                    </item>
                </argument>
            </container>
        </fieldset>
    </modal>
</form>
