<?xml version="1.0"?>
<logging xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Logging:etc/logging.xsd">
    <groups>
        <group name="ewave_advancedinventory">
            <label translate="true">Ewave Advanced Inventory</label>
            <expected_models>
                <expected_model class="Magento\CatalogInventory\Model\Stock\Item">
                    <additional_fields>
                        <field name="item_id" />
                    </additional_fields>
                </expected_model>
            </expected_models>
            <events>
                <event controller_action="ewave_advancedinventory_advancedinventory_edit" action_alias="view" />
                <event controller_action="ewave_advancedinventory_advancedinventory_save" action_alias="save">
                    <skip_on_back>
                        <controller_action name="ewave_advancedinventory_advancedinventory_edit" />
                    </skip_on_back>
                </event>
            </events>
        </group>
    </groups>
</logging>
