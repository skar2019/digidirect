<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Ewave_AdvancedInventory::config" title="Ewave Advanced Inventory" sortOrder="100" />
                        </resource>
                    </resource>
                </resource>
                <resource id="Ewave_Utilities::ewave" sortOrder="10">
                    <resource id="Ewave_AdvancedInventory::advancedinventory_view" sortOrder="10" title="Advanced Inventory">
                        <resource id="Ewave_AdvancedInventory::advancedinventory_edit" sortOrder="10" title="Edit" />
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
