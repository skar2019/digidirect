<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="ewave_advancedinventory" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
            <label>Advanced Inventory</label>
            <tab>ewave</tab>
            <resource>Ewave_AdvancedInventory::config</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>General</label>
                <field id="enable" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Enable Advanced Inventory</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="abstract_entities" translate="label" type="multiselect" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Abstract Entities For Advanced Inventory</label>
                    <source_model>Ewave\AbstractEntity\Model\Config\Source\AttributeSet</source_model>
                </field>
            </group>
            <group id="order_assignment" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Stock Assignment</label>
                <field id="assignment_rule" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Stock Assignment Rule</label>
                    <source_model>Ewave\AdvancedInventory\Model\Source\AssignmentRule</source_model>
                </field>
                <field id="website_stock" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Website Stock</label>
                    <source_model>Ewave\AdvancedInventory\Model\Source\Stock</source_model>
                    <depends>
                        <field id="assignment_rule">website</field>
                    </depends>
                    <validate>required-entry</validate>
                </field>
            </group>
        </section>
    </system>
</config>
